<view class="page">
  <view class="tabs"><view class="tab {{status === '' ? 'active' : ''}}" data-status="" bindtap="onStatusTap">全部</view><view class="tab {{status === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="onStatusTap">待处理</view><view class="tab {{status === 'reviewing' ? 'active' : ''}}" data-status="reviewing" bindtap="onStatusTap">审核中</view><view class="tab {{status === 'resolved' ? 'active' : ''}}" data-status="resolved" bindtap="onStatusTap">已处理</view></view>
  <view class="report card" wx:for="{{reports}}" wx:key="_id"><view class="row"><text class="reason">{{item.reason}}</text><text class="status">{{item.status}}</text></view><text class="target">{{item.targetType}} · {{item.targetName || item.targetId}}</text><text class="meta">举报人：{{item.reporterOpenId}}</text><view class="actions" wx:if="{{item.status === 'pending' || item.status === 'reviewing'}}"><button size="mini" data-id="{{item._id}}" data-status="reviewing" bindtap="onUpdate">审核中</button><button size="mini" class="danger" data-id="{{item._id}}" bindtap="onTakeDown">下架内容</button><button size="mini" class="danger" data-id="{{item._id}}" bindtap="onBanAuthor">封禁作者</button><button size="mini" data-id="{{item._id}}" data-status="dismissed" bindtap="onUpdate">驳回</button></view></view>
  <view class="state" wx:if="{{loading}}">加载中...</view><view class="state" wx:if="{{!loading && error}}"><text>{{error}}</text><text class="retry" bindtap="onRetry">重试</text></view><view class="state" wx:if="{{!loading && !error && reports.length === 0}}">暂无举报</view>
</view>

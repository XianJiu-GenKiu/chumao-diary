@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page{min-height:100vh;background:#f7f8fa;padding:24rpx;box-sizing:border-box}.tabs{display:flex;background:#fff;border-radius:16rpx;overflow:hidden;margin-bottom:20rpx}.tab{flex:1;text-align:center;padding:20rpx 8rpx;font-size:24rpx;color:#777}.tab.active{color:#d4890e;font-weight:600;border-bottom:4rpx solid #d4890e}.card{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}.row{display:flex;justify-content:space-between}.reason{font-size:30rpx;font-weight:600}.status,.meta{font-size:24rpx;color:#888}.target{display:block;margin:16rpx 0;color:#444}.actions{display:flex;gap:12rpx}.actions button{margin:0;font-size: 24rpx}.state{padding:100rpx 20rpx;text-align:center;color:#999}.retry{display:block;color:#d4890e;margin-top:16rpx}

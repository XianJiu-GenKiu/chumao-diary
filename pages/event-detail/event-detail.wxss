@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page-event-detail {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 140rpx;
}

/* ── 封面 ── */
.event-hero {
  position: relative;
  height: 460rpx;
  background: linear-gradient(135deg, #1A1A2E, #2D3A54);
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 60rpx 32rpx 32rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.hero-status {
  display: inline-flex;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 16rpx;
}

.hero-status.upcoming { background: rgba(46, 204, 113, 0.85); }
.hero-status.ongoing { background: rgba(212, 137, 14, 0.85); }
.hero-status.ended { background: rgba(149, 165, 166, 0.85); }

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

/* ── 信息区 ── */
.info-section {
  margin: 24rpx;
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid var(--color-border);
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

/* ── 介绍 ── */
.desc-section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

/* ── 标签 ── */
.tags-section {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(212, 137, 14, 0.1);
}

/* ── 参与人员 ── */
.participants-section {
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
  background: var(--color-surface);
  border-radius: 20rpx;
}

.participants-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
}

.participant-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.p-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg);
}

.p-name {
  font-size: 24rpx;
  color: var(--color-text-hint);
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-surface);
  border-top: 1rpx solid var(--color-border);
  z-index: 10;
}

.bar-actions {
  display: flex;
  gap: 40rpx;
}

.bar-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 8rpx;
}

.bar-action:active {
  opacity: 0.7;
}

.join-btn {
  padding: 20rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: var(--color-primary);
  color: #fff;
  border: none;
  line-height: 1;
}

.join-btn::after { border: none; }

.join-btn.joined {
  background: var(--color-bg);
  color: var(--color-text-hint);
  border: 2rpx solid var(--color-border);
}

.join-btn.disabled {
  background: var(--color-bg);
  color: var(--color-text-hint);
  opacity: 0.5;
}

.join-btn:active {
  opacity: 0.8;
  transform: scale(0.97);
}

/* ── 骨架屏 ── */
.skeleton {
  padding: 0 24rpx;
}

.sk-hero {
  height: 460rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 0;
}

.sk-line {
  height: 32rpx;
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 8rpx;
  margin-top: 24rpx;
}

.sk-line.short { width: 60%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ── 深色模式 ── */
.dark-theme .info-section,
.dark-theme .desc-section,
.dark-theme .tags-section,
.dark-theme .participants-section,
.dark-theme .bottom-bar {
  background: #1E1E2E;
  border-color: rgba(255, 255, 255, 0.06);
}

.dark-theme .tag {
  background: rgba(212, 137, 14, 0.15);
}

.dark-theme .join-btn.joined {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.1);
}

.dark-theme .sk-hero,
.dark-theme .sk-line {
  background: linear-gradient(90deg, #2a2a3a 25%, #353550 50%, #2a2a3a 75%);
  background-size: 200% 100%;
}

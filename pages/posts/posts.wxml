<!-- 动态页 - 帖子 Feed（类似朋友圈） -->
<view class="page page-posts {{darkMode ? 'dark-theme' : ''}}">
  <!-- 顶部 tab 切换：关注 / 发现 / 附近 -->
  <view class="tabs tab-bar">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >
      {{item.name}}
    </view>
    <!-- 滑动指示器 -->
    <view class="tab-indicator" style="transform: translateX({{activeTabIndex * 100}}%);">
      <view class="tab-indicator-bar"></view>
    </view>
  </view>

  <!-- 帖子 Feed -->
  <view class="post-feed">

    <!-- 骨架屏加载 -->
    <block wx:if="{{isLoading && postList.length === 0}}">
      <view class="skeleton-card card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="post-header">
          <view class="skeleton-block skeleton-avatar"></view>
          <view class="post-author-info" style="flex:1;">
            <view class="skeleton-block skeleton-text" style="width: 120rpx;"></view>
            <view class="skeleton-block skeleton-text" style="width: 80rpx; height: 10px; margin-top: 8rpx;"></view>
          </view>
        </view>
        <view class="skeleton-block skeleton-text" style="width: 100%; margin-top: 16rpx;"></view>
        <view class="skeleton-block skeleton-text" style="width: 80%;"></view>
      </view>
    </block>
    <view
      class="post-card card"
      wx:for="{{postList}}"
      wx:key="_id"
    >
      <!-- 帖子头部：头像 + 昵称 + 时间 -->
      <view class="post-header" data-openid="{{item.creatorOpenId}}" bindtap="onAuthorTap">
        <image
          class="post-avatar"
          wx:if="{{item.authorAvatar}}"
          src="{{item.authorAvatar}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="post-avatar avatar-placeholder" wx:else></view>
        <view class="post-author-info">
          <text class="post-nickname">{{item.authorName || '匿名用户'}}</text>
          <text class="post-time">{{item.createTimeText || ''}}</text>
        </view>
      </view>

      <!-- 帖子文字内容 -->
      <view class="post-content" data-id="{{item._id}}" bindtap="onPostTap">
        <text class="post-text">{{item.content}}</text>
      </view>

      <!-- 帖子图片 -->
      <view class="post-images image-count-{{item.images.length}}" wx:if="{{item.images && item.images.length > 0}}">
        <image
          class="post-image {{item.images.length === 1 ? 'single' : ''}}"
          wx:for="{{item.images}}"
          wx:for-item="img"
          wx:for-index="imgIdx"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          lazy-load
        />
      </view>

      <!-- 关联地点 -->
      <view class="post-location" wx:if="{{item.locationName}}" data-id="{{item.locationId}}" bindtap="onLocationTap">
        <icon name="map-pin" size="24" color="#D4890E" />
        <text class="location-text">{{item.locationName}}</text>
      </view>

      <!-- 帖子底部操作栏 -->
      <view class="post-actions">
        <view
          class="action-item {{item.reactionUp ? 'liked' : ''}}"
          data-id="{{item._id}}"
          data-index="{{index}}"
          data-type="up"
          bindtap="onReactionTap"
        >
          <icon name="thumbs-up" size="44" color="{{item.reactionUp ? '#D4890E' : '#999'}}" fill="{{item.reactionUp}}" />
          <text class="action-count">{{item.reactionUpCount || 0}}</text>
        </view>
        <view
          class="action-item {{item.reactionDown ? 'liked' : ''}}"
          data-id="{{item._id}}"
          data-index="{{index}}"
          data-type="down"
          bindtap="onReactionTap"
        >
          <icon name="thumbs-down" size="44" color="{{item.reactionDown ? '#D4890E' : '#999'}}" fill="{{item.reactionDown}}" />
          <text class="action-count">{{item.reactionDownCount || 0}}</text>
        </view>
        <view
          class="action-item"
          data-id="{{item._id}}"
          bindtap="onCommentTap"
        >
          <icon name="message-circle" size="44" color="#999" />
          <text class="action-count">{{item.commentCount || 0}}</text>
        </view>
        <view class="action-item">
          <button class="share-btn" open-type="share" data-id="{{item._id}}">
            <icon name="share" size="44" color="#999" />
          </button>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <text class="loading-text">加载中…</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && postList.length > 0}}">
      <text class="no-more-text">— 已经到底了 —</text>
    </view>
    <view class="empty-state" wx:if="{{!isLoading && errorMessage}}">
      <icon name="alert-circle" size="96" color="#D4890E" />
      <text class="empty-title">动态加载失败</text>
      <text class="empty-desc">{{errorMessage}}</text>
      <view class="empty-action" bindtap="onRetry">
        <icon name="refresh-cw" size="28" color="#fff" />
        <text>重新加载</text>
      </view>
    </view>
    <view class="empty-state" wx:if="{{!isLoading && !errorMessage && postList.length === 0}}">
      <icon name="file-text" size="96" color="#ddd" />
      <text class="empty-title">{{activeTab === 'nearby' && locationDenied ? '需要定位权限' : '还没有动态'}}</text>
      <text class="empty-desc">{{activeTab === 'nearby' && locationDenied ? '开启定位后即可查看同城毛友的动态' : (activeTab === 'follow' ? '关注更多毛友，查看他们的动态' : '分享你的外景拍摄故事，让大家看到你')}}</text>
      <!-- 同城未授权时优先引导开启定位，否则再引导发布 -->
      <view class="empty-action" bindtap="onOpenLocationSetting" wx:if="{{activeTab === 'nearby' && locationDenied}}">
        <icon name="map-pin" size="28" color="#fff" />
        <text>开启定位</text>
      </view>
      <view class="empty-action" bindtap="onFabTap" wx:elif="{{activeTab !== 'follow'}}">
        <icon name="edit" size="28" color="#fff" />
        <text>发布动态</text>
      </view>
    </view>
  </view>

  <!-- FAB 发动态 -->
  <view class="fab-btn" bindtap="onFabTap">
    <icon name="edit" size="40" color="#fff" />
  </view>

  <!-- 回到顶部按钮 -->
  <view class="back-to-top {{showBackToTop ? '' : 'hidden'}}" bindtap="scrollToTop">
    <icon name="chevron-up" size="36" color="#D4890E" />
  </view>

</view>

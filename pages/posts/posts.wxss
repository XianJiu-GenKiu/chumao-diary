@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

/* 动态页 */
.page-posts {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: calc(var(--tab-bar-height) + 32rpx);
}

/* ── Tab 栏 ────────────────────────────────── */
.tab-bar {
  position: sticky;
  top: 0;
  z-index: 10;
}

/* 顶部 Tab 字号加大：32rpx（16px），激活态再加粗，保证一眼可辨 */
.tab-bar .tab-item {
  font-size: 32rpx;
  letter-spacing: 1rpx;
  min-height: 96rpx;
}

.tab-bar .tab-item.active {
  font-size: 34rpx;
  font-weight: var(--font-weight-heavy);
}

/* Tab 滑动指示器 */
.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 33.33%;
  height: 8rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.tab-indicator-bar {
  width: 56rpx;
  height: 100%;
  border-radius: 4rpx;
  background: var(--color-primary, #D4890E);
}

/* 滑动指示器取代静态 ::after 指示线 */
.tab-bar .tab-item.active::after {
  display: none;
}

/* ── 帖子 Feed ─────────────────────────────── */
.post-feed {
  padding: 0 var(--page-padding);
}

.post-card {
  margin-bottom: var(--space-3);
}

/* 头部 */
.post-header {
  display: flex;
  align-items: center;
  padding: var(--space-4) var(--space-4) var(--space-3);
}

.post-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: var(--space-3);
}

.post-author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.post-nickname {
  font-size: 32rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.post-time {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

/* 文字内容 */
.post-content {
  padding: 0 var(--space-4) var(--space-3);
}

.post-text {
  font-size: 30rpx;
  color: var(--color-text-primary);
  line-height: var(--line-height-relaxed);
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 图片 */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  padding: 0 var(--space-4) var(--space-3);
}

.post-image {
  width: calc(33.33% - 8rpx);
  aspect-ratio: 1;
  border-radius: var(--radius-sm);
  object-fit: cover;
}

.post-image.single {
  width: 100%;
  max-height: 400rpx;
  aspect-ratio: auto;
}

.post-images.image-count-2 .post-image,
.post-images.image-count-4 .post-image {
  width: calc(50% - 6rpx);
}

/* 关联地点 */
.post-location {
  display: flex;
  align-items: center;
  padding: 0 var(--space-4) var(--space-3);
}

.location-icon {
  margin-right: var(--space-1);
  font-size: var(--text-sm);
}

.location-text {
  font-size: 27rpx;
  color: var(--color-primary);
}

/* 操作栏：四个动作等宽均分，视觉重心均匀
   早期实现每个 .action-item 固定 margin-right，导致分享按钮被压在最右侧、
   左侧三项挤在一起；改用 space-between + 等分 flex 后间距自然均匀。 */
.post-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-5);
  border-top: 1rpx solid var(--color-divider);
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  padding: var(--space-2) 0;
}

.action-item:active {
  opacity: 0.7;
}

.action-item.liked {
  color: var(--color-danger);
}

.action-icon {
  font-size: var(--text-lg);
  margin-right: var(--space-1);
}

.action-count {
  font-size: 28rpx;
  color: var(--color-text-hint);
  font-variant-numeric: tabular-nums;
}

.action-item.liked .action-count {
  color: var(--color-danger);
}

/* 分享按钮：去掉 button 默认样式与固定宽度，使其与其他动作视觉一致 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
  border: 0;
}

.share-btn::after {
  border: 0;
}

.share-btn:active {
  opacity: 0.7;
}

/* ── 回到顶部按钮 ── */
.back-to-top {
  position: fixed;
  right: 32rpx;
  bottom: calc(var(--tab-bar-height) + 176rpx);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-bg-white);
  box-shadow: var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 90;
  transition: opacity 0.3s var(--ease-bezier), transform 0.3s var(--ease-emphasized);
}
.back-to-top.hidden {
  opacity: 0;
  pointer-events: none;
  transform: translateY(20rpx);
}
.back-to-top:active {
  opacity: 0.8;
  transform: scale(0.92);
}

/* ── 加载 / 空状态 ──────────────────────────── */
.loading-more,
.no-more,
.empty-state {
  display: flex;
  justify-content: center;
  padding: var(--space-6) 0;
}

.loading-text,
.no-more-text {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
}

.empty-state {
  flex-direction: column;
  align-items: center;
  padding: var(--space-12) 0;
  gap: 12rpx;
}

.empty-title {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
  text-align: center;
  max-width: 400rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: var(--space-4);
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
}

.empty-action:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.empty-text {
  font-size: var(--text-base);
  color: var(--color-text-hint);
}

/* ── FAB ── */
.fab-btn {
  position: fixed;
  right: 32rpx;
  /* 原生 TabBar 会覆盖视口底部，发布按钮必须位于其上方。 */
  bottom: calc(var(--tab-bar-height) + 24rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(212, 137, 14, 0.35);
  z-index: 50;
  animation: cm-pop-in 0.44s var(--ease-spring) both;
}
.fab-btn:active { opacity: 0.85; transform: scale(0.94); transition: transform var(--duration-fast) var(--ease-spring), opacity var(--duration-fast) var(--ease-bezier); }
.fab-icon { font-size: 44rpx; }

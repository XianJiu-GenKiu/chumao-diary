/* pages/messages/messages.wxss */
@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.messages-page {
  min-height: 100vh;
  background: var(--color-bg-page, #F5F5F5);
  padding-bottom: env(safe-area-inset-bottom);
}

/* —— 顶部 Tab —— */
.msg-tabs {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
  border-bottom: 1rpx solid var(--color-border, #eee);
  position: sticky;
  top: 0;
  z-index: 10;
}
.msg-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary, #999);
  position: relative;
  gap: 6rpx;
}
.msg-tab.active {
  color: var(--color-primary, #D4890E);
  font-weight: 600;
}
.msg-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--color-primary, #D4890E);
  border-radius: 2rpx;
}
.tab-badge {
  font-size: 24rpx;
  background: #e74c3c;
  color: #fff;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  min-width: 28rpx;
  text-align: center;
  line-height: 1.4;
}

/* —— 已读提示栏 —— */
.mark-read-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #FFF9F0;
  border-bottom: 1rpx solid #F0E0C0;
}
.mark-read-text {
  font-size: 26rpx;
  color: var(--color-text-secondary, #999);
}
.mark-read-btn {
  font-size: 26rpx;
  color: var(--color-primary, #D4890E);
  font-weight: 600;
}

/* —— 消息列表 —— */
.msg-list {
  padding: 0 0 32rpx;
}
.msg-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border, #f0f0f0);
  gap: 20rpx;
  position: relative;
}
.msg-item.unread {
  background: #FFFBF5;
}
.msg-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-gray-100, #f0f0f0);
}
.msg-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}
.msg-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.msg-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary, #333);
}
.msg-time {
  font-size: 24rpx;
  color: var(--color-text-hint, #ccc);
}
.msg-text {
  font-size: 26rpx;
  color: var(--color-text-secondary, #666);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.msg-target {
  background: var(--color-bg-tag, #f5f5f5);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}
.msg-target-text {
  font-size: 24rpx;
  color: var(--color-text-hint, #999);
}
.msg-type-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.unread-dot {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  width: 16rpx;
  height: 16rpx;
  background: #e74c3c;
  border-radius: 50%;
}

/* —— 加载更多 —— */
.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: var(--color-text-hint, #ccc);
}

/* —— 空状态 —— */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0 80rpx;
  gap: 12rpx;
}
.empty-icon {
  font-size: 96rpx;
}
.empty-text {
  font-size: 32rpx;
  color: var(--color-text-secondary, #999);
}
.empty-hint {
  font-size: 24rpx;
  color: var(--color-text-hint, #ccc);
}

/* —— 加载中 —— */
.loading-state {
  text-align: center;
  padding: 48rpx;
  font-size: 26rpx;
  color: var(--color-text-hint, #999);
}

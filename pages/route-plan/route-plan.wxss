@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page{min-height:100vh;background:#f7f8fa}.summary{display:flex;flex-direction:column;gap:10rpx;padding:28rpx;background:#fff;color:#777;font-size:26rpx}.title{font-size: 32rpx;font-weight:600;color:#222}.hint{color:#999;font-size:24rpx}.share-card{color:#d4890e;font-size:26rpx;margin-top:8rpx}.map{width:100%;height:420rpx}.route-list{padding:20rpx 24rpx}.route-item{display:flex;align-items:center;gap:20rpx;padding:24rpx;margin-bottom:16rpx;border-radius:16rpx;background:#fff}.number{display:flex;align-items:center;justify-content:center;width:46rpx;height:46rpx;border-radius:50%;background:#fff3df;color:#d4890e;font-weight:600}.info{display:flex;flex:1;min-width:0;flex-direction:column;gap:8rpx}.name{font-size:30rpx;color:#222}.address{font-size:24rpx;color:#888;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.state{padding:100rpx 24rpx;text-align:center;color:#999}.state text:last-child{display:block;margin-top:16rpx;color:#d4890e}.summary-meta{font-size:26rpx;color:#666}.mode-switch{display:flex;gap:16rpx;margin:6rpx 0}.mode-item{min-height:72rpx;padding:0 32rpx;display:flex;align-items:center;border-radius:999rpx;background:#f2f3f5;color:#666;font-size:26rpx}.mode-item.active{background:#fff3df;color:#d4890e;font-weight:500}.hint.warn{color:#d4890e}

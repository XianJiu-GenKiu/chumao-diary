<view class="page"><view class="summary" wx:if="{{collection}}"><text class="title">{{collection.name}}</text><text class="summary-meta">{{route.length}} 个地点 · {{distanceText}}{{durationText ? ' · ' + durationText : ''}}</text><view class="mode-switch"><text wx:for="{{modes}}" wx:key="key" class="mode-item {{routeMode === item.key ? 'active' : ''}}" data-mode="{{item.key}}" bindtap="onModeTap">{{item.label}}</text></view><text class="hint" wx:if="{{routePlanning}}">正在规划路线…</text><text class="hint warn" wx:elif="{{routeDegraded}}">路线规划暂不可用，当前为直线示意</text><text class="hint" wx:else>长按地点可移出合集</text><text class="share-card" bindtap="onShareCard">生成分享卡片</text></view><map class="map" wx:if="{{route.length}}" latitude="{{route[0].latitude}}" longitude="{{route[0].longitude}}" markers="{{markers}}" polyline="{{polyline}}" include-points="{{route}}" scale="12" /><view class="route-list" wx:if="{{route.length}}"><view class="route-item" wx:for="{{route}}" wx:key="_id" data-index="{{index}}" bindtap="openLocation" bindlongpress="removeLocation"><view class="number">{{index + 1}}</view><view class="info"><text class="name">{{item.name}}</text><text class="address">{{item.address || '暂无地址'}}</text></view><icon name="navigation" size="30" color="#D4890E" /></view></view><view class="state" wx:if="{{loading}}">正在规划路线...</view><view class="state" wx:if="{{!loading && error}}"><text>{{error}}</text><text bindtap="onRetry">重试</text></view><view class="state" wx:if="{{!loading && !error && route.length === 0}}">合集内暂无可导航地点</view></view>

<!-- 搜索页 - 地点搜索 -->
<view class="page page-search {{darkMode ? 'dark-theme' : ''}}">

  <!-- 自定义顶部导航栏 -->
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <view class="nav-bar-content">
      <!-- 返回按钮 -->
      <view class="nav-back" bindtap="onCancel">
        <icon name="arrow-left" size="36" color="#333" />
      </view>
      <!-- 搜索框 -->
      <view class="search-bar-wrap">
        <view class="search-input-bar">
          <icon name="search" size="32" color="#999" />
          <input
            class="search-input"
            placeholder="搜索地点、动态…"
            focus="{{isFocused}}"
            value="{{keyword}}"
            confirm-type="search"
            bindinput="onInput"
            bindconfirm="onConfirm"
          />
          <view class="clear-icon" wx:if="{{keyword}}" bindtap="onClearInput"><icon name="x" size="28" color="#999" /></view>
        </view>
      </view>
    </view>
  </view>
  <!-- 导航栏占位 -->
  <view class="nav-bar-spacer" style="height: {{totalNavHeight}}px;"></view>

  <!-- 输入联想建议（输入时显示，替换热门搜索） -->
  <view class="suggest-panel" wx:if="{{suggestList.length > 0 && keyword.length > 0}}">
    <view
      class="suggest-item"
      wx:for="{{suggestList}}"
      wx:key="_id"
      data-keyword="{{item.name || item.title}}"
      bindtap="onSuggestTap"
    >
      <icon name="{{item._type === 'map_poi' ? 'map-pin' : 'search'}}" size="28" color="#D4890E" />
      <view class="suggest-info">
        <text class="suggest-name">{{item.searchLabel || item.name || item.title}}</text>
        <text class="suggest-addr" wx:if="{{item.address}}">{{item.address}}</text>
      </view>
      <text class="suggest-type tag tag-{{item._type === 'post' ? 'secondary' : 'primary'}}">{{item._type === 'map_poi' ? '地图' : item._type === 'post' ? '帖子' : '地点'}}</text>
    </view>
  </view>

  <!-- 搜索前：热门搜索 + 搜索历史（无候选词时显示） -->
  <block wx:if="{{!hasSearched && suggestList.length === 0}}">

    <!-- 热门搜索 -->
    <view class="search-section">
      <view class="section-title"><icon name="fire" size="30" color="#D4890E" />热门搜索</view>
      <view class="hot-tags">
        <view
          class="tag tag-outline hot-tag"
          wx:for="{{hotKeywords}}"
          wx:key="*this"
          data-keyword="{{item}}"
          bindtap="onHotTap"
        >
          {{item}}
        </view>
      </view>
    </view>

    <!-- 搜索历史 -->
    <view class="search-section" wx:if="{{historyList.length > 0}}">
      <view class="section-header-row">
        <view class="section-title"><icon name="clock" size="30" color="#D4890E" />搜索历史</view>
        <text class="clear-btn" bindtap="clearHistory">清空</text>
      </view>
      <view class="history-list">
        <view
          class="history-item"
          wx:for="{{historyList}}"
          wx:key="*this"
          data-keyword="{{item}}"
          bindtap="onHistoryTap"
        >
          {{item}}
        </view>
      </view>
    </view>

  </block>

  <!-- 搜索结果 -->
  <block wx:if="{{hasSearched}}">

    <!-- 筛选条件层 -->
    <view class="search-filters">
      <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-list">
          <view
            class="filter-chip {{activeSceneFilter === item.key ? 'active' : ''}}"
            wx:for="{{sceneFilters}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onSceneFilter"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </view>

    <!-- 加载中 -->
    <view class="search-loading" wx:if="{{isSearching && resultList.length === 0}}">
      <view class="search-skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="search-skeleton-cover"></view>
        <view class="search-skeleton-info">
          <view class="search-skeleton-line title"></view>
          <view class="search-skeleton-line"></view>
          <view class="search-skeleton-line short"></view>
        </view>
      </view>
    </view>

    <!-- 结果列表 -->
    <view class="result-list" wx:if="{{resultList.length > 0}}">
      <view
        class="result-item card"
        wx:for="{{resultList}}"
        wx:key="_id"
        data-id="{{item._id}}"
        data-type="{{item._type || 'location'}}"
        data-item="{{item}}"
        bindtap="onResultTap"
      >
        <image
          class="result-cover"
          wx:if="{{item.coverUrl || (item.images && item.images.length > 0)}}"
          src="{{item.coverUrl || item.images[0]}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="result-info">
          <view class="result-title-row">
            <text class="result-name">{{item.name || item.content || item.title || '无标题'}}</text>
            <text class="tag tag-{{item._type === 'post' ? 'secondary' : 'primary'}} result-type-badge">{{item._type === 'post' ? '动态' : item._type === 'map_poi' ? '地图' : '地点'}}</text>
          </view>
          <text class="result-desc" wx:if="{{item.address || item.description || item.content}}">{{item.address || item.description || (item.content && item.content.length > 40 ? item.content.slice(0, 40) + '...' : item.content)}}</text>
          <text class="result-author" wx:if="{{item._type === 'post' && item.authorName}}">by {{item.authorName}}</text>
          <view class="result-meta">
            <text class="tag tag-outline" wx:if="{{item.category || item.categoryName}}">{{item.category || item.categoryName}}</text>
            <text class="tag tag-outline" wx:if="{{item._type === 'location'}}">{{item.indoor ? '室内' : '室外'}}</text>
            <view class="tag tag-primary" wx:if="{{item._type === 'location' && item.rating}}"><icon name="star" size="16" color="#D4890E" fill="{{true}}" /> {{item.rating}}</view>
            <text class="tag tag-outline" wx:if="{{item._type === 'map_poi'}}">地图</text>
            <view class="result-location" wx:if="{{item.distance}}"><icon name="map-pin" size="16" color="#999" /> {{item.distance}}</view>
          </view>
          <view class="result-meta" wx:if="{{item._type === 'location' && item.facilities && item.facilities.length}}">
            <text class="tag tag-outline" wx:for="{{item.facilities}}" wx:for-item="facility" wx:key="key">{{facility.name || facility}}</text>
          </view>
        </view>
      </view>

      <!-- 加载更多提示 -->
      <view class="loading-more" wx:if="{{isSearching}}">
        <text class="loading-text">加载中…</text>
      </view>
      <view class="no-more" wx:if="{{!hasMore}}">
        <text class="no-more-text">— 没有更多结果了 —</text>
      </view>
    </view>

    <!-- 搜索失败（不能伪装成「没有找到相关内容」） -->
    <view class="empty-state" wx:if="{{searchError && !isSearching && resultList.length === 0}}">
      <icon name="alert-circle" size="96" color="#ddd" />
      <text class="empty-title">搜索失败</text>
      <text class="empty-desc">{{searchError}}</text>
      <view class="empty-action" bindtap="onRetrySearch">
        <icon name="refresh-cw" size="28" color="#D4890E" />
        <text>重试</text>
      </view>
    </view>

    <!-- 无结果 -->
    <view class="empty-state" wx:if="{{!searchError && !isSearching && resultList.length === 0}}">
      <icon name="search" size="96" color="#ddd" />
      <text class="empty-title">没有找到相关内容</text>
      <text class="empty-desc">试试搜索"公园"、"夜景"或"森林"</text>
      <view class="empty-action" bindtap="onClearInput">
        <icon name="refresh-cw" size="28" color="#D4890E" />
        <text>重新搜索</text>
      </view>
    </view>

  </block>

</view>

@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
page { background: #F7F8FA; }
.xj-create-page { min-height: 100vh; color: #1A1A1A; }
.xj-create-nav { height: 96rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: space-between; background: #fff; font-size: 34rpx; font-weight: 600; border-bottom: 1rpx solid #F0F0F0; }
.xj-create-nav > view { width: 56rpx; font-size: 56rpx; font-weight: 300; line-height: 1; color: #707070; }
.nav-step { width: 56rpx; color: #909090; font-size: 24rpx; font-weight: 400; text-align: right; }
.xj-create-scroll { height: calc(100vh - 188rpx); }
.xj-section { margin: 24rpx 24rpx 0; padding: 28rpx 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(30,30,30,.04); }
.xj-section-title { margin-bottom: 22rpx; font-size: 32rpx; font-weight: 600; }
.xj-section-title-row { display: flex; justify-content: space-between; align-items: center; }
.xj-section-title-row .xj-section-title { margin-bottom: 0; }
.xj-muted { color: #909090; font-size: 24rpx; font-weight: 400; }
.xj-link { color: #D4890E; font-size: 26rpx; }
.xj-cover-upload { position: relative; height: 300rpx; overflow: hidden; border-radius: 20rpx; background: #FFF7E6; }
.xj-cover-upload > image { width: 100%; height: 100%; }
.xj-cover-empty { height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12rpx; color: #D4890E; font-size: 26rpx; }
.xj-cover-empty text:last-child { color: #B58A49; font-size: 24rpx; }
.xj-cover-edit { position: absolute; right: 20rpx; bottom: 20rpx; padding: 14rpx 26rpx; border-radius: 999rpx; color: #fff; background: rgba(0,0,0,.45); font-size: 24rpx; }
.xj-field { margin-top: 26rpx; }
.xj-label { display: block; margin-bottom: 12rpx; color: #505050; font-size: 26rpx; }
.required { color: #E02020; }
.xj-field input, .xj-field textarea { width: 100%; box-sizing: border-box; padding: 22rpx 18rpx; border-radius: 14rpx; background: #F7F8FA; color: #1A1A1A; font-size: 28rpx; line-height: 40rpx; }
.xj-field input { height: 84rpx; }
.xj-field textarea { min-height: 164rpx; line-height: 1.6; }
.xj-tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.xj-tag { padding: 12rpx 20rpx; border-radius: 999rpx; background: #F0F0F0; color: #707070; font-size: 24rpx; }
.xj-tag.active { background: #FFF0D1; color: #D4890E; font-weight: 600; }
.xj-point-list { margin-top: 8rpx; }
.xj-point { display: flex; align-items: center; min-height: 92rpx; border-bottom: 1rpx solid #F0F0F0; }
.xj-point-num { width: 44rpx; height: 44rpx; margin-right: 18rpx; border-radius: 50%; background: #D4890E; color: #fff; font-size: 24rpx; line-height: 44rpx; text-align: center; }
.xj-point-main { flex: 1; }
.xj-point-name { display: block; font-size: 28rpx; font-weight: 500; }
.xj-point-meta { display: flex; gap: 10rpx; margin-top: 6rpx; color: #909090; font-size: 24rpx; }
.xj-point-delete { padding: 18rpx; color: #B0B0B0; font-size: 38rpx; }
.xj-tip { display: flex; gap: 8rpx; margin-top: 20rpx; color: #A47A31; font-size: 24rpx; line-height: 1.5; }
.xj-inline-fields { display: flex; gap: 20rpx; }
.xj-inline-fields .compact { flex: 1; }
.xj-check-row { display: flex; align-items: flex-start; gap: 16rpx; margin: 16rpx 0; font-size: 28rpx; }
.xj-check { width: 38rpx; height: 38rpx; flex-shrink: 0; border: 2rpx solid #D0D0D0; border-radius: 50%; color: transparent; font-size: 25rpx; line-height: 38rpx; text-align: center; }
.xj-check.checked { border-color: #D4890E; background: #D4890E; color: #fff; }
.block { display: block; margin-top: 6rpx; line-height: 1.5; }
.xj-bottom-space { height: 40rpx; }
.xj-submit-bar { position: fixed; right: 0; bottom: 0; left: 0; display: flex; gap: 18rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -4rpx 18rpx rgba(0,0,0,.06); }
.xj-submit-bar button { flex: 1; height: 88rpx; margin: 0; border-radius: 999rpx; color: #D4890E; background: #FFF7E6; font-size: 28rpx; }
.xj-submit-bar button::after { border: 0; }
.xj-submit-bar button.primary { flex: 1.5; color: #fff; background: #D4890E; }

.xj-add-point-form { display: flex; align-items: center; gap: 12rpx; margin-top: 18rpx; padding: 12rpx; border-radius: 14rpx; background: #FFF9EF; }
.xj-add-point-form input { flex: 1; min-width: 0; height: 80rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 10rpx; background: #fff; font-size: 26rpx; }
.xj-add-point-form text { flex-shrink: 0; display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 0 12rpx; color: #D4890E; font-size: 26rpx; white-space: nowrap; }

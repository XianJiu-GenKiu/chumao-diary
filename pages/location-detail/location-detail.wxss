/* pages/location-detail/location-detail.wxss */
@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page-location-detail {
  background: var(--color-bg-page, #F5F5F5);
  min-height: 100vh;
}

/* ── 轮播图 ── */
.swiper-wrap {
  position: relative;
  width: 100%;
}
.banner-swiper {
  width: 100%;
  height: 480rpx;
}
.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}
.swiper-counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ── 地点信息区 ── */
.detail-section {
  padding: 24rpx 32rpx;
  background: #fff;
  margin-bottom: 16rpx;
}
.location-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.more-btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-bg-tag, #F0F0F0);
  flex-shrink: 0;
}
.more-icon {
  font-size: 40rpx;
  color: var(--color-text-secondary, #999);
  line-height: 1;
}
.location-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A2E;
  flex: 1;
}
.rating-badge {
  display: flex;
  align-items: center;
  background: var(--color-primary-bg, #FFF7E6);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  gap: 4rpx;
  flex-shrink: 0;
}

/* 5 星显示（支持半星） */
.rating-stars-display {
  display: flex;
  gap: 2rpx;
}
.rating-star-slot {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  overflow: hidden;
}
.rating-star-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.rating-star-fill.full {
  width: 100%;
}
.rating-star-fill.half {
  width: 50%;
}
.rating-star {
  font-size: 24rpx;
}
.rating-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary, #D4890E);
}
.location-category {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #909090;
}
.address-row { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 14rpx; color: #777; font-size: 26rpx; }
.copy-address { flex-shrink: 0; color: #D4890E; }
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* ── 维度评分展示 ── */
.dim-scores {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.dim-score-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
}

.dim-score-label {
  width: 120rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.dim-score-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.dim-score-bar {
  height: 100%;
  background: var(--color-primary, #D4890E);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.dim-score-value {
  width: 48rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary, #D4890E);
  flex-shrink: 0;
}

/* ── 天气卡片 ── */
.weather-card {
  margin: 0 32rpx 16rpx;
}
.weather-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
}
.weather-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.weather-label {
  font-size: 24rpx;
  color: #909090;
}
.weather-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-top: 4rpx;
}

/* ── 段落标题 ── */
.section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}
.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

/* ── 地图 ── */
.detail-map {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  position: relative;
}
.detail-map-locate-btn {
  position: absolute;
  left: 18rpx;
  bottom: 18rpx;
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #D4890E;
  font-size: 40rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.18);
}
.map-nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: var(--color-primary-bg, #FFF7E6);
  color: var(--color-primary, #D4890E);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
}
.map-nav-btn:active {
  opacity: 0.8;
}

/* ── 底部操作栏 ── */
.bottom-placeholder {
  height: 300rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-evenly;
  height: 140rpx;
  padding: 0 16rpx;
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}
.bottom-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  max-width: 120rpx;
  padding: 8rpx 0;
  border-radius: 16rpx;
  transition: background 0.2s;
}
.bottom-action:active {
  background: rgba(212, 137, 14, 0.06);
}
.action-text {
  font-size: 26rpx;
  color: var(--color-text-secondary, #666);
  font-weight: 500;
  text-align: center;
  line-height: 1;
  white-space: nowrap;
}

/* ── 加载状态 ── */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.loading-text {
  font-size: 28rpx;
  color: #909090;
}

/* ── 相关帖子列表 ── */
.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.post-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.post-item:last-child {
  border-bottom: none;
}
.post-cover {
  width: 160rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.post-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  overflow: hidden;
}
.post-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A2E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.post-author {
  font-size: 24rpx;
  color: #909090;
  margin-top: 8rpx;
}

/* ── 评论列表 ── */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.comment-item {
  display: flex;
  gap: 20rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.comment-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.comment-avatar-placeholder {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.comment-body {
  flex: 1;
}
.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}
.comment-time {
  font-size: 24rpx;
  color: #909090;
}
.comment-text {
  font-size: 28rpx;
  color: #1A1A2E;
  line-height: 1.6;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 8rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
  padding: 4rpx 0;
}

.comment-action:active {
  opacity: 0.6;
}

.comment-like-count {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.reply-list {
  background: var(--color-gray-50);
  border-radius: var(--radius-sm);
  padding: 12rpx 20rpx;
  margin-top: 12rpx;
}

.reply-item {
  display: flex;
  gap: 8rpx;
  padding: 6rpx 0;
  font-size: 26rpx;
}

.reply-name {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
  flex-shrink: 0;
}

.reply-text {
  color: var(--color-text-primary);
}

.reply-hint {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.reply-cancel {
  color: var(--color-primary);
  margin-left: 12rpx;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 0;
  gap: 8rpx;
}
.empty-comments-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #666;
  margin-top: 12rpx;
}
.empty-comments-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}
.empty-comments-action {
  padding: 14rpx 36rpx;
  background: var(--color-primary-bg, #FFF7E6);
  color: var(--color-primary, #D4890E);
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--radius-button, 24px);
}
.empty-comments-action:active {
  opacity: 0.8;
}

/* ── 评论输入框 ── */
.comment-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 101;
}
.comment-input {
  flex: 1;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 999rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.comment-clear-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #E5E5E5;
  flex-shrink: 0;
}
.comment-clear-btn:active {
  opacity: 0.7;
}
.comment-send-btn {
  padding: 0 32rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E0E0E0;
  color: #999;
  border-radius: 999rpx;
  font-size: 28rpx;
  flex-shrink: 0;
}
.comment-send-btn.active {
  background: var(--color-primary, #D4890E);
  color: #fff;
}

/* ── 分享按钮重置 ── */
.share-btn {
  background: none;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
}
.share-btn::after {
  border: none;
}

/* ── 室内/外 Badge ── */
.indoor-badge {
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.indoor-badge.indoor {
  background: #EBF3FC;
  color: #4A90D9;
}
.indoor-badge.outdoor {
  background: #E8F5E9;
  color: #4CAF50;
}

/* ── 周边设施 ── */
.facility-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.facility-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: #F5F5F5;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  gap: 6rpx;
}
.best-time {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #666;
  gap: 8rpx;
}

/* ── 热门评价 ── */
.section-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.view-all {
  font-size: 24rpx;
  color: var(--color-primary, #D4890E);
}
.hot-review-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.hot-review-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  gap: 16rpx;
}
.review-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F0F0F0;
}
.review-body {
  flex: 1;
  min-width: 0;
}
.review-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A2E;
  display: block;
}
.review-text {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.review-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* ── 我来出毛按钮 ── */
.go-shoot-btn {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  margin: 24rpx 32rpx 32rpx;
  padding: 24rpx;
  text-align: center;
  background: var(--color-primary, #D4890E);
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  z-index: 1;
  box-shadow: 0 4rpx 16rpx rgba(212, 137, 14, 0.3);
}
.go-shoot-btn:active {
  opacity: 0.85;
}

/* 评分弹窗（多维度） */
.rating-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 200;
}

.rating-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 80vh;
  /* --color-surface 未在全局 token 中定义，会导致弹窗透明。 */
  background: var(--color-bg-card, #FFFFFF);
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--color-border, #E5E5E5);
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.14);
  z-index: 201;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.rating-modal-title {
  display: block;
  text-align: center;
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.rating-modal-sub {
  display: block;
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-text-hint);
  margin-bottom: 24rpx;
}

/* 维度评分行 */
.dim-rating-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-gray-100, #f0f0f0);
}

.dim-rating-row:last-of-type {
  border-bottom: none;
}

.dim-rating-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.dim-rating-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.dim-rating-hint {
  font-size: 24rpx;
  color: var(--color-text-hint, #999);
  margin-top: 4rpx;
}

.dim-rating-stars {
  display: flex;
  gap: 4rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dim-star {
  padding: 4rpx;
  transition: transform 0.15s;
}

.dim-star:active {
  transform: scale(1.25);
}

/* 综合评分预览 */
.overall-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  margin-top: 20rpx;
  background: var(--color-primary-bg, #FFF7E6);
  border-radius: 16rpx;
  gap: 12rpx;
}

.overall-preview-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.overall-preview-stars {
  display: flex;
  gap: 4rpx;
}

/* 综合预览的半星槽位（图标 32rpx） */
.overall-star-slot {
  width: 32rpx;
  height: 32rpx;
}

.overall-preview-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-primary, #D4890E);
}

/* 旧版兼容：总体星级选择器 */
.rating-stars {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.rating-star-item {
  padding: 8rpx;
}

.rating-star-item:active {
  transform: scale(1.2);
}

.rating-modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

.rating-modal-cancel,
.rating-modal-confirm {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
}

.rating-modal-cancel {
  background: var(--color-gray-100);
  color: var(--color-text-secondary);
}

.rating-modal-confirm {
  background: var(--color-primary);
  color: #fff;
}

.rating-modal-cancel:active,
.rating-modal-confirm:active {
  opacity: 0.8;
}

.rating-count {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
  margin-left: 4rpx;
}

/* ── 底部操作栏 — 深色模式 ── */
.dark-theme .bottom-bar {
  background: #1E1E2E;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.3);
}
.dark-theme .rating-modal {
  background: var(--color-bg-card, #1E1E2E);
  border-color: var(--color-border, #2A2A3E);
}
.dark-theme .action-text {
  color: rgba(255, 255, 255, 0.6);
}
.dark-theme .bottom-action:active {
  background: rgba(212, 137, 14, 0.12);
}


/* ── 地点详情页新版视觉层级 ── */
.page-location-detail {
  background: #F7F8FA;
  color: #1A1A1A;
  padding-bottom: 24rpx;
}
.detail-section,
.weather-card {
  margin: 16rpx 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 18rpx rgba(58, 43, 20, 0.05);
}
.location-info-card {
  margin-top: 0;
  padding-top: 32rpx;
  background: linear-gradient(180deg, #FFFDF8 0%, #FFFFFF 100%);
  border-top: 6rpx solid #D4890E;
}
.location-title-row,
.location-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.location-title-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
  flex: 1;
}
.location-kicker {
  font-size: 24rpx;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #B87918;
  font-weight: 600;
}
.location-name {
  display: block;
  font-size: 44rpx;
  line-height: 1.25;
  letter-spacing: -0.5rpx;
  color: #2B241C;
  font-weight: 700;
}
.more-btn {
  width: 88rpx;
  height: 88rpx;
  background: #FFF1D5;
}
.more-icon { font-size: 44rpx; color: #9B6817; }
.location-meta-row {
  justify-content: flex-start;
  gap: 18rpx;
  margin-top: 24rpx;
}
.indoor-badge {
  min-height: 52rpx;
  padding: 8rpx 18rpx;
  gap: 6rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.rating-badge {
  min-height: 64rpx;
  padding: 8rpx 18rpx;
  gap: 8rpx;
  border: 1rpx solid #F2D39A;
  box-sizing: border-box;
}
.rating-stars-display { gap: 3rpx; }
.rating-star-slot {
  width: 32rpx;
  height: 32rpx;
}
.rating-value { font-size: 32rpx; font-weight: 700; }
.rating-count { font-size: 24rpx; color: #9A8061; }
.location-category {
  margin-top: 22rpx;
  padding: 8rpx 18rpx;
  background: #FFF1D5;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #9B6817;
}
.address-row {
  align-items: flex-start;
  margin-top: 22rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #5D574F;
}
.address-text { flex: 1; }
.copy-address { font-size: 26rpx; font-weight: 600; }
.tag-list { gap: 14rpx; margin-top: 22rpx; }
.tag { font-size: 26rpx; padding: 8rpx 18rpx; }
.dim-scores { margin-top: 28rpx; padding-top: 24rpx; }
.dim-score-item { gap: 16rpx; padding: 9rpx 0; }
.dim-score-label { width: 132rpx; font-size: 26rpx; }
.dim-score-bar-wrap { height: 16rpx; }
.dim-score-value { width: 56rpx; font-size: 26rpx; }
.section-title {
  font-size: 34rpx;
  line-height: 1.35;
  margin-bottom: 20rpx;
  color: #2B241C;
  font-weight: 700;
}
.desc-text { font-size: 30rpx; line-height: 1.8; color: #514B44; }
.facility-tags { gap: 14rpx; }
.facility-tag { padding: 12rpx 20rpx; font-size: 28rpx; }
.best-time { margin-top: 20rpx; font-size: 28rpx; line-height: 1.5; }
.card-header { font-size: 34rpx; font-weight: 700; margin-bottom: 22rpx; }
.weather-label { font-size: 26rpx; }
.weather-value { font-size: 32rpx; margin-top: 8rpx; }
.post-title { font-size: 30rpx; }
.post-author { font-size: 26rpx; }
.hot-review-card { padding: 22rpx; }
.review-name { font-size: 28rpx; }
.review-text { font-size: 28rpx; line-height: 1.55; }
.view-all { font-size: 28rpx; }
.comment-section { padding-bottom: 32rpx; }
.comment-list { gap: 28rpx; }
.comment-name { font-size: 28rpx; }
.comment-time { font-size: 26rpx; }
.comment-text { font-size: 30rpx; line-height: 1.75; }
.comment-actions { margin-top: 14rpx; gap: 28rpx; }
.comment-action,
.comment-like-count { font-size: 26rpx; }
.reply-item { font-size: 28rpx; line-height: 1.55; }
.empty-comments-title { font-size: 34rpx; }
.empty-comments-desc { font-size: 28rpx; }
.empty-comments-action { font-size: 28rpx; padding: 16rpx 40rpx; }
.detail-map { height: 340rpx; border-radius: 18rpx; }
.map-nav-btn { height: 84rpx; font-size: 30rpx; font-weight: 600; border-radius: 16rpx; }
.go-shoot-btn { margin: 28rpx 24rpx 36rpx; padding: 28rpx; border-radius: 20rpx; font-size: 32rpx; }

/* 底部操作栏与评论输入框分层：评论输入框在操作栏上方，不再遮挡评论内容或按钮 */
.bottom-placeholder {
  height: 310rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.bottom-bar {
  height: 136rpx;
  min-height: 136rpx;
  padding: 0 10rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  border-top: 1rpx solid #F0E4D0;
  box-shadow: 0 -6rpx 24rpx rgba(58, 43, 20, 0.12);
  z-index: 120;
}
.bottom-action {
  min-height: 96rpx;
  max-width: 132rpx;
  gap: 8rpx;
  padding: 10rpx 4rpx;
}
.action-text { font-size: 26rpx; line-height: 1.2; color: #5D574F; }
.comment-input-bar {
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #F0E4D0;
  z-index: 121;
}
.comment-input { height: 88rpx; font-size: 30rpx; }
.comment-send-btn { height: 88rpx; padding: 0 34rpx; font-size: 30rpx; }
.reply-hint { font-size: 26rpx; }

/* 评分弹窗中的星级扩大，保证可点击 */
.rating-modal-title { font-size: 36rpx; }
.rating-modal-sub { font-size: 26rpx; }
.dim-rating-label { font-size: 30rpx; }
.dim-rating-hint { font-size: 26rpx; line-height: 1.4; }
.dim-rating-stars { gap: 8rpx; }
.dim-star { padding: 8rpx; }
.overall-preview-label { font-size: 28rpx; }
.overall-preview-value { font-size: 32rpx; }
.rating-modal-cancel,
.rating-modal-confirm { padding: 26rpx; font-size: 30rpx; }

.dark-theme .detail-section,
.dark-theme .weather-card { box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.18); }
.dark-theme .location-info-card { background: linear-gradient(180deg, #29251D 0%, #1E1E2E 100%); }
.dark-theme .location-name,
.dark-theme .section-title,
.dark-theme .card-header { color: var(--color-text-primary); }
.dark-theme .desc-text,
.dark-theme .address-row,
.dark-theme .comment-text { color: var(--color-text-secondary); }


/* ── 自定义导航栏：可控标题字号，保持与品牌暖橙色一致 ── */
.detail-nav {
  background: #FFFDF8;
  color: #2B241C;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F0E4D0;
}
.detail-nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.detail-nav-back,
.detail-nav-placeholder {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-nav-back:active { background: #FFF1D5; border-radius: 50%; }
.detail-nav-back text {
  font-size: 58rpx;
  font-weight: 300;
  line-height: 0.8;
  color: #7D5C2A;
}
.detail-nav-title {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #2B241C;
}

/* 星级与评分数字在同一条中线，避免图标因行高落到下方 */
.rating-badge,
.rating-stars-display,
.rating-star-slot {
  align-items: center;
}
.rating-stars-display { height: 36rpx; }
.rating-star-slot {
  display: flex;
  line-height: 0;
}
.rating-star-slot > icon,
.rating-star-fill { display: flex; align-items: center; height: 32rpx; }
.rating-value,
.rating-count { line-height: 1; }

/* 底部两层连续贴合：功能栏内容垂直居中，评论区紧贴在其上方 */
.bottom-bar {
  height: calc(112rpx + env(safe-area-inset-bottom));
  min-height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 0 10rpx env(safe-area-inset-bottom);
  align-items: center;
  box-sizing: border-box;
}
.bottom-action {
  height: 96rpx;
  min-height: 96rpx;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}
.comment-input-bar {
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  min-height: 110rpx;
  box-sizing: border-box;
  justify-content: center;
}
.bottom-placeholder {
  height: calc(222rpx + env(safe-area-inset-bottom));
}
.dark-theme .detail-nav {
  background: #1E1E2E;
  border-color: #2A2A3E;
}
.dark-theme .detail-nav-title { color: var(--color-text-primary); }
.dark-theme .detail-nav-back text { color: #E0A030; }


/* ── 地点详情图片：与卡片体系统一的圆角包边显示 ── */
.swiper-wrap {
  width: auto;
  height: 440rpx;
  margin: 20rpx 24rpx 16rpx;
  overflow: hidden;
  border: 2rpx solid #F0E4D0;
  border-radius: 28rpx;
  background: #EFE8DE;
  box-shadow: 0 6rpx 20rpx rgba(58, 43, 20, 0.10);
}
.banner-swiper {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  overflow: hidden;
}
.banner-image {
  border-radius: 26rpx;
}
.swiper-counter {
  right: 20rpx;
  bottom: 18rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(43, 36, 28, 0.58);
  font-size: 26rpx;
  line-height: 1;
}
.dark-theme .swiper-wrap {
  border-color: #4A3C27;
  background: #29251D;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.24);
}

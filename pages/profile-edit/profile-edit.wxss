@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page-profile-edit {
  min-height: 100vh;
  padding: 32rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.cover-editor {
  position: relative;
  width: calc(100vw - 16rpx);
  height: 410rpx;
  margin: 10rpx -24rpx 52rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FFF0EC 0%, #EBF3FC 52%, #E8F5E9 100%);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}

.cover-preview {
  width: calc(100% + 8rpx);
  height: calc(100% + 8rpx);
  margin: -4rpx;
  display: block;
  border-radius: 18rpx;
  filter: blur(2rpx);
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #8f6f5f;
}

.cover-placeholder-title {
  font-size: 28rpx;
  font-weight: 600;
}

.cover-placeholder-subtitle {
  font-size: 24rpx;
  color: #a99b93;
}

.cover-mask {
  position: absolute;
  inset: 0;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.18));
  pointer-events: none;
}

.cover-actions {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 16rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  z-index: 2;
}

.cover-action {
  min-width: 112rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #333;
  font-size: 24rpx;
  text-align: center;
}

.cover-action.secondary {
  background: rgba(26, 26, 26, 0.62);
  color: #fff;
}

.avatar-row {
  position: absolute;
  left: 50%;
  top: 30rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #fff;
  font-size: 24rpx;
  z-index: 3;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: #eee;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.14);
}

.avatar-tip {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.38);
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

input,
textarea {
  width: 100%;
  font-size: 28rpx;
  color: #222;
}

textarea {
  min-height: 180rpx;
}

.save-btn {
  margin-top: 32rpx;
  padding: 24rpx;
  text-align: center;
  color: #fff;
  background: #D4890E;
  border-radius: 12rpx;
}

.save-btn.disabled {
  opacity: .55;
}

@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page {
  min-height: 100vh;
  background: var(--color-bg-page);
}

.state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: var(--color-text-hint);
  font-size: var(--text-base);
}

.empty-title {
  display: block;
  color: var(--color-text-secondary);
  font-size: var(--text-base);
}

.empty-desc {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-hint);
  font-size: var(--text-sm);
  line-height: 1.6;
}

.retry {
  display: inline-block;
  margin-top: 24rpx;
  padding: 20rpx 48rpx;
  min-height: 72rpx;
  line-height: 32rpx;
  border-radius: 36rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: var(--text-base);
}

.list {
  padding: 16rpx 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx var(--page-padding);
  background: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-border);
}

.avatar {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-gray-100);
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  color: var(--color-text-primary);
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hint {
  color: var(--color-text-hint);
  font-size: var(--text-sm);
}

.unblock {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: var(--color-gray-100);
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
}

.unblock:active {
  opacity: 0.85;
}

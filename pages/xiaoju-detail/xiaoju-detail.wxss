@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
page { background: #F7F8FA; }
.xj-detail-page { min-height: 100vh; color: #1A1A1A; }
.xj-detail-hero { position: relative; height: 560rpx; overflow: hidden; background: #C6D9EB; }
.xj-detail-hero > image { width: 100%; height: 100%; }
.hero-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(180deg, rgba(0,0,0,.28), rgba(0,0,0,.02) 45%, rgba(0,0,0,.8)); }
.hero-back { position: absolute; top: 42rpx; left: 28rpx; width: 80rpx; height: 80rpx; border-radius: 50%; color: #fff; background: rgba(0,0,0,.28); font-size: 62rpx; font-weight: 200; line-height: 70rpx; text-align: center; }
.hero-title-wrap { position: absolute; right: 32rpx; bottom: 36rpx; left: 32rpx; color: #fff; }
.hero-title { display: block; font-size: 44rpx; font-weight: 600; line-height: 1.3; }
.hero-author { display: block; margin-top: 12rpx; color: rgba(255,255,255,.8); font-size: 24rpx; }
.xj-detail-scroll { height: calc(100vh - 720rpx); }
.xj-detail-summary, .xj-detail-section { margin: 24rpx 24rpx 0; padding: 26rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(30,30,30,.04); }
.summary-tags { display: flex; gap: 12rpx; }
.summary-tags text { padding: 8rpx 16rpx; border-radius: 999rpx; background: #FFF0D1; color: #D4890E; font-size: 24rpx; }
.summary-text { display: block; margin-top: 20rpx; color: #505050; font-size: 28rpx; line-height: 1.55; }
.summary-stats { display: flex; gap: 20rpx; margin-top: 22rpx; color: #909090; font-size: 24rpx; }
.detail-section-title { margin-bottom: 22rpx; font-size: 32rpx; font-weight: 600; }
.route-line { position: relative; }
.route-line:before { position: absolute; top: 28rpx; bottom: 34rpx; left: 23rpx; width: 2rpx; background: #F4D7A3; content: ''; }
.route-stop { position: relative; display: flex; gap: 18rpx; min-height: 128rpx; }
.route-dot { z-index: 1; width: 48rpx; height: 48rpx; flex-shrink: 0; border-radius: 50%; color: #fff; background: #D4890E; font-size: 24rpx; line-height: 48rpx; text-align: center; }
.route-stop-main { flex: 1; padding-bottom: 24rpx; }
.route-stop-head { display: flex; justify-content: space-between; align-items: center; }
.route-stop-head text:first-child { font-size: 28rpx; font-weight: 600; }
.route-stop-type { padding: 8rpx 16rpx; border-radius: 999rpx; color: #D4890E; background: #FFF7E6; font-size: 24rpx; }
.route-stop-duration, .route-stop-note { display: block; margin-top: 8rpx; color: #909090; font-size: 26rpx; line-height: 1.5; }
.route-stop-note { color: #707070; }
.route-map { position: relative; height: 280rpx; overflow: hidden; border-radius: 18rpx; background: #E8F5FC; }
.map-grid { position: absolute; top: 0; right: 0; bottom: 0; left: 0; opacity: .4; background: repeating-linear-gradient(30deg, transparent 0 42rpx, rgba(126,158,178,.2) 43rpx 46rpx); }
.map-route { position: absolute; top: 0; right: 0; bottom: 0; left: 0; }
.map-route:before { position: absolute; top: 56%; right: 18%; left: 14%; height: 6rpx; background: #D4890E; transform: rotate(-12deg); content: ''; }
.map-point { position: absolute; width: 48rpx; height: 48rpx; border: 4rpx solid #fff; border-radius: 50%; color: #fff; background: #D4890E; font-size: 24rpx; line-height: 48rpx; text-align: center; box-shadow: 0 4rpx 10rpx rgba(0,0,0,.15); }
.map-caption { position: absolute; right: 18rpx; bottom: 16rpx; left: 18rpx; color: #6D8490; font-size: 24rpx; }
.author-note { padding: 18rpx; margin-top: 14rpx; border-radius: 14rpx; background: #FFF9EF; color: #505050; font-size: 25rpx; line-height: 1.6; }
.note-label { display: block; margin-bottom: 6rpx; color: #D4890E; font-weight: 600; }
.xj-detail-bottom-space { height: 170rpx; }
.xj-detail-actions { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; gap: 18rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97); box-shadow: 0 -4rpx 18rpx rgba(0,0,0,.06); }
.detail-action { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 96rpx; min-height: 88rpx; color: #707070; font-size: 24rpx; }
.start-btn { flex: 1; height: 88rpx; margin: 0; border-radius: 999rpx; color: #fff; background: #D4890E; font-size: 28rpx; line-height: 88rpx; }
.start-btn::after { border: 0; }

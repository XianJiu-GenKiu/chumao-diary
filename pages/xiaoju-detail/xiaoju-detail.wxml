<view class="xj-detail-page">
  <view class="xj-detail-hero"><image src="{{item.cover}}" mode="aspectFill" /><view class="hero-shade"></view><view class="hero-back" bindtap="goBack">‹</view><view class="hero-title-wrap"><text class="hero-title">{{item.title}}</text><text class="hero-author">{{item.author}} · 发布于 {{item.createdText}}</text></view></view>
  <scroll-view scroll-y class="xj-detail-scroll">
    <view class="xj-detail-summary"><view class="summary-tags"><text wx:for="{{item.tags}}" wx:key="*this">{{item}}</text></view><text class="summary-text">{{item.summary}}</text><view class="summary-stats"><text>📍 {{item.points.length}} 个点位</text><text>⏱ {{item.duration}}</text><text>👥 {{item.people}}</text></view></view>
    <view class="xj-detail-section"><view class="detail-section-title">路线安排</view><view class="route-line"><view wx:for="{{item.points}}" wx:key="id" class="route-stop"><view class="route-dot">{{index + 1}}</view><view class="route-stop-main"><view class="route-stop-head"><text>{{item.name}}</text><text class="route-stop-type">{{item.type}}</text></view><text class="route-stop-duration">{{item.duration}}</text><text class="route-stop-note" wx:if="{{item.note}}">{{item.note}}</text></view></view></view></view>
    <view class="xj-detail-section"><view class="detail-section-title">路线概览</view><view class="route-map"><view class="map-grid"></view><view class="map-route"><view wx:for="{{item.points}}" wx:key="id" class="map-point" style="left: {{12 + index * 34}}%; top: {{58 - (index % 2) * 24}}%;">{{index + 1}}</view></view><text class="map-caption">路线点位仅作参考，出发前请再次确认开放时间</text></view></view>
    <view class="xj-detail-section" wx:if="{{item.reason || item.notice}}"><view class="detail-section-title">作者说明</view><view class="author-note" wx:if="{{item.reason}}"><text class="note-label">推荐理由</text><text>{{item.reason}}</text></view><view class="author-note" wx:if="{{item.notice}}"><text class="note-label">出发前提醒</text><text>{{item.notice}}</text></view></view>
    <view class="xj-detail-bottom-space"></view>
  </scroll-view>
  <view class="xj-detail-actions"><view class="detail-action" bindtap="toggleSave"><icon name="bookmark" size="36" color="#D4890E" /><text>{{item.saved ? '已收藏' : '收藏路线'}}</text></view><view class="detail-action" bindtap="toggleLike"><icon name="thumbs-up" size="36" color="#D4890E" /><text>点赞 {{item.likes}}</text></view><button class="start-btn" bindtap="startEvent">按此路线发起活动</button></view>
</view>

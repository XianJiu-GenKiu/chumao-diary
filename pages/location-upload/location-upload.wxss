/* pages/location-upload/location-upload.wxss */
@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page-location-upload {
  background: var(--color-bg-page, #F5F5F5);
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* ── 顶部提示条 ── */
.upload-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  background: var(--color-primary-bg, #FFF7E6);
}
.banner-icon {
  font-size: 32rpx;
}
.banner-text {
  font-size: 26rpx;
  color: var(--color-primary, #D4890E);
  font-weight: 500;
}

.stepper {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 48rpx;
  background: #fff;
  margin-bottom: 16rpx;
}
.stepper-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #aaa;
  font-size: 24rpx;
}
.stepper-dot {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #e5e5e5;
  color: #999;
  font-size: 24rpx;
}
.stepper-item.active { color: var(--color-primary, #D4890E); }
.stepper-item.active .stepper-dot { background: var(--color-primary, #D4890E); color: #fff; }

/* ── 表单段落 ── */
.form-section {
  background: #fff;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
}
.required {
  color: var(--color-danger, #E02020);
}

/* ── Picker ── */
.picker-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: var(--touch-comfort, 48px);
  background: var(--color-gray-100, #F0F0F0);
  border-radius: var(--radius-md, 8px);
  padding: 0 var(--space-4, 16px);
}
.picker-value {
  font-size: 28rpx;
  color: #1A1A2E;
  position: relative;
  top: -16rpx;
}
.picker-placeholder {
  font-size: 28rpx;
  color: #CCCCCC;
  position: relative;
  top: -16rpx;
}
/* 下拉箭头图标样式：用于 Picker 组件右侧的指示箭头 */
.picker-arrow {
  font-size: 48pxrpx;
  color: #CCC;
}

/* ── 标签输入 ── */
.tag-input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.tag-input {
  flex: 1;
}
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.tag-removable {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding-right: 8rpx;
}
.tag-remove {
  font-size: 28rpx;
  opacity: 0.6;
  padding: 0 4rpx;
}

/* ── 图片上传网格 ── */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.upload-image {
  width: 100%;
  height: 100%;
}
.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-gray-100, #F0F0F0);
  border-radius: 12rpx;
  border: 2rpx dashed #CCC;
}
.add-icon {
  font-size: 48rpx;
  color: #CCC;
  line-height: 1;
}
.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ── 地理位置 ── */
.location-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.re-locate {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  color: var(--color-primary, #D4890E);
}
.location-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--color-gray-50, #FAFAFA);
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}
.location-icon {
  font-size: 24rpx;
}
.location-text {
  font-size: 26rpx;
  color: #666;
}
.location-text.placeholder {
  color: #CCC;
}
.address-suggestions {
  margin-top: 12rpx;
  border: 1rpx solid #EEE;
  border-radius: 10rpx;
  overflow: hidden;
}
.address-suggestion {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #F1F1F1;
}
.address-suggestion:last-child { border-bottom: 0; }
.suggestion-name { font-size: 28rpx; color: #222; }
.suggestion-address { font-size: 24rpx; color: #999; }
.visibility-hint, .form-hint { display: block; margin-top: 14rpx; font-size: 24rpx; color: #999; }
.field-gap { margin-top: 16rpx; }
.notice-textarea { min-height: 150rpx; }
.weather-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
}
.weather-icon {
  font-size: 24rpx;
}
.weather-text {
  font-size: 24rpx;
  color: #909090;
}

/* ── 描述 ── */
.textarea {
  min-height: 200rpx;
}

/* ── 提交 ── */
.submit-area {
  padding: 32rpx;
}
.step-actions { display: flex; gap: 20rpx; padding: 32rpx; }
.step-btn { flex: 1; text-align: center; }

/* ── 室内/外切换 ── */
.toggle-row {
  display: flex;
  gap: 16rpx;
}
.toggle-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid #E5E5E5;
  border-radius: 8rpx;
  font-size: 28rpx;
}
.toggle-item.active {
  border-color: var(--color-primary, #D4890E);
  background: var(--color-primary-bg, #FFF7E6);
  color: var(--color-primary, #D4890E);
}

/* ── 场景风格 ── */
.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.style-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 8rpx;
  font-size: 24rpx;
  min-width: 130rpx;
}
.style-item.active {
  border-color: var(--color-primary, #D4890E);
  background: var(--color-primary-bg, #FFF7E6);
}
.style-icon { font-size: 36rpx; margin-bottom: 4rpx; }
.style-name { font-size: 24rpx; }

/* ── 设施勾选 ── */
.facility-check-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.facility-check {
  padding: 12rpx 20rpx;
  border: 2rpx solid #E5E5E5;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}
.facility-check.active {
  border-color: var(--color-primary, #D4890E);
  background: var(--color-primary-bg, #FFF7E6);
  color: var(--color-primary, #D4890E);
}

/* ── 星级评分 ── */
.star-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.star { font-size: 48rpx; }
.star-filled { color: #FFD93D; }
.star-empty { color: #D0D0D0; }
.rating-text {
  font-size: 28rpx;
  color: #666;
  margin-left: 8rpx;
}

/* ── 地图选点 ── */
.upload-map {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

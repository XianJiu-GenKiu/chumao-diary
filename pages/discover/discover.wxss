@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

/* ── 页面 ── */
.page-discover {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: calc(var(--tab-bar-height) + 32rpx);
}

/* ── 自定义顶部导航栏 ── */
.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--color-bg-white);
  box-shadow: 0 1px 4px rgba(131, 68, 68, 0.04);
}

.status-bar-placeholder {
  width: 100%;
}

/* 小程序标题 */
.app-title {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.app-title .app-title-text {
  font-family: 'ChumaoBrand', var(--font-family-display);
  font-size: 50rpx;
  font-weight: var(--font-weight-normal);
  color: var(--color-primary);
  letter-spacing: 6rpx;
  /* 字距会在末字后追加空白，补一个左内距让标题真正居中 */
  padding-left: 6rpx;
  line-height: 1.1;
  /* 品牌字体首屏可能尚未就绪，先用系统字体保证不出现空白。 */
  font-display: swap;
}

.nav-quick-actions {
  position: absolute;
  right: var(--page-padding);
  top: 0;
  height: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nav-bar-content {
  display: flex;
  align-items: center;
  padding: 0 var(--page-padding);
  gap: var(--space-3);
}

/* 头像 */
.nav-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
}

.nav-avatar:active {
  opacity: 0.8;
}

.nav-avatar-img {
  width: 100%;
  height: 100%;
}

.nav-avatar-default {
  width: 100%;
  height: 100%;
  background: var(--color-gray-100);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-avatar-icon {
  font-size: 36rpx;
}

/* 搜索框 */
.nav-search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  height: 64rpx;
  min-width: 0;
  background: var(--color-gray-100);
  border-radius: var(--radius-round);
  padding: 0 var(--space-3) 0 var(--space-4);
  transition: background var(--duration-fast) var(--ease-out);
  overflow: hidden;
}

.nav-search-bar:active {
  background: var(--color-gray-200);
}

.nav-search-icon {
  font-size: var(--text-sm);
  margin-right: var(--space-2);
}

.nav-search-placeholder {
  font-size: var(--font-size-sm);
  color: var(--color-text-hint);
  /* 无论文案多长都保持单行，超出部分省略，排版不再换行 */
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.2;
  max-width: 100%;
}

/* 文案包裹层负责裁剪，避免 flex 子项被挤压换行 */
.nav-search-text-wrap {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
}

/* 城市选择器 */
.nav-city-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--space-1);
  max-width: 190rpx;
  padding: var(--space-1) 0 var(--space-1) var(--space-1);
  border-radius: var(--radius-sm);
  transition: background var(--duration-fast);
}

.nav-city-wrap:active {
  background: var(--color-gray-100);
}

/* 活动入口 */
.nav-event-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(212, 137, 14, 0.1);
  flex-shrink: 0;
  margin-left: 4rpx;
}

.nav-event-btn:active {
  opacity: 0.7;
  transform: scale(0.92);
}

.nav-city-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: var(--font-weight-medium);
}

.nav-city-arrow {
  font-size: 24rpx;
  color: var(--color-text-hint);
  transition: transform var(--duration-fast);
}

/* ── 精选地点抽屉（取代原「视角快切筛选栏」） ──
   收起态只露一条滑动条 + 标题；下拉展开精选地点列表。
   高度由 JS 驱动（featuredBodyHeight），因此这里不做 max-height 过渡。 */
.featured-drawer {
  width: 100%;
  background: var(--color-bg-white);
  border-top: 1rpx solid var(--color-divider);
  overflow: hidden;
}

.featured-handle {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 var(--page-padding);
}

/* 滑动条：放在 handle 下边框，提示「可下拉展开 / 上拉收起」 */
.featured-handle-bar {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 64rpx;
  height: 8rpx;
  margin-left: -32rpx;
  border-radius: 999rpx;
  background: var(--color-gray-300);
}

.featured-handle-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.featured-handle-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: var(--font-size-2xs);
  font-weight: var(--font-weight-bold);
  line-height: 30rpx;
  text-align: center;
}

.featured-handle-arrow {
  position: absolute;
  right: var(--page-padding);
  transition: transform var(--duration-fast) var(--ease-out);
}

.featured-handle-arrow.up {
  transform: rotate(180deg);
}

.featured-body {
  overflow: hidden;
  transition: height 0.3s var(--ease-emphasized);
}

.featured-drawer.dragging .featured-body {
  transition: none;
}

.featured-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 0 var(--page-padding) var(--space-3);
}

.featured-card {
  display: flex;
  gap: 16rpx;
  padding: 14rpx;
  margin-bottom: 12rpx;
  border-radius: var(--radius-md);
  background: var(--color-gray-50);
}

.featured-card:active {
  opacity: 0.8;
}

.featured-cover {
  width: 140rpx;
  height: 108rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.featured-cover-placeholder {
  background: var(--color-gray-200);
}

.featured-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.featured-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.featured-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.featured-loc {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.featured-empty {
  padding: 40rpx 0;
  text-align: center;
}

.featured-empty-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* ── 城市选择浮层 ── */
.city-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1200;
  animation: cm-fade-in var(--duration-fast) var(--ease-bezier);
}

.city-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-white);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 1201;
  transform: translateY(100%);
  transition: transform var(--duration-normal) var(--ease-emphasized), opacity var(--duration-normal) var(--ease-bezier);
  max-height: 70vh;
}

.city-panel.show {
  transform: translateY(0);
}

.city-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4);
  border-bottom: 1rpx solid var(--color-divider);
}

.city-panel-title {
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.city-panel-close {
  font-size: var(--font-size-xl);
  color: var(--color-text-hint);
  padding: var(--space-2);
}

/* 城市搜索栏 */
.city-search-bar {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-page);
  border-bottom: 1rpx solid var(--color-divider);
}

.city-search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-divider);
}

.city-search-icon {
  font-size: var(--font-size-lg);
  margin-left: var(--space-2);
}

.city-empty-tip {
  padding: var(--space-8) var(--space-4);
  text-align: center;
  color: var(--color-text-hint);
  font-size: var(--font-size-sm);
}

.city-panel-subtitle {
  padding: var(--space-3) var(--space-4);
  background: var(--color-gray-50);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.city-panel-content {
  padding: var(--space-2) 0;
  overflow-y: auto;
  max-height: calc(70vh - 160rpx);
}

.city-panel-item {
  display: flex;
  align-items: center;
  padding: var(--space-3) var(--space-4);
  transition: background var(--duration-fast);
}

.city-panel-item:active {
  background: var(--color-gray-100);
}

.city-panel-item.active {
  background: var(--color-primary-bg);
}

.city-panel-item-name {
  flex: 1;
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
}

.city-panel-item.active .city-panel-item-name {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.city-panel-item-location {
  font-size: var(--font-size-xs);
  color: var(--color-text-hint);
  margin-right: var(--space-2);
}

.city-panel-item-check {
  font-size: var(--font-size-lg);
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

/* ── 地图模式容器 ── */
.map-mode {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
}

/* 地图区域（固定高度，面板覆盖其上） */
.map-section {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.discover-map {
  width: 100%;
  height: 100%;
}

/* ── 地点面板（三段式 bottom sheet） ──
   收起态：手柄 + 环境栏；半开态：+ 地点概况；全开态：+ 详情与操作。
   height / transform 由 JS 计算成 px 后内联到 style，这里只负责外观与布局，
   避免依赖 CSS 变量做 calc 在真机上出现偏差。 */
.float-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-white);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
  z-index: 50;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: transform 0.36s var(--ease-emphasized), box-shadow 0.36s var(--ease-bezier);
}

.float-panel.dragging {
  transition: none;
}

/* 拖拽手柄 */
.panel-handle {
  flex-shrink: 0;
  height: 32rpx;
  padding: 12rpx 0 8rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.handle-bar {
  width: 64rpx;
  height: 8rpx;
  background: var(--color-gray-300);
  border-radius: 999rpx;
}

/* 环境信息条：任何档位都可见，固定在面板顶部 */
.env-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-shrink: 0;
  height: 108rpx;
  box-sizing: border-box;
  padding: 12rpx 24rpx;
  margin: 0 24rpx 12rpx;
  background: var(--color-gray-50);
  border-radius: var(--radius-md);
}

.env-item-sm {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.env-val {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.env-lbl {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.env-dot {
  width: 4rpx;
  height: 24rpx;
  background: var(--color-divider);
}

/* ── 地点概况（收起 / 半开 / 全开都可见） ──
   概况只放「这是什么地方」，操作一律下沉到面板底部的 .poi-actions。 */

.panel-poi-head {
  flex-shrink: 0;
  padding: 4rpx 28rpx 16rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.panel-poi-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-poi-name {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: var(--font-weight-bold);
  line-height: 1.25;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-poi-subline {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.poi-distance {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
  white-space: nowrap;
}

.poi-category-tag {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 230rpx;
  padding: 6rpx 18rpx;
  border: 1rpx solid #F0C36A;
  border-radius: 999rpx;
  background: #FFF1D6;
  color: #A96800;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poi-uncollected-tag {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--color-gray-100);
  color: var(--color-text-hint);
  font-size: 24rpx;
  white-space: nowrap;
}

/* 地址行：概况的一部分，各档位都能复制的地址 */
.panel-poi-addr-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.panel-poi-addr-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.panel-poi-copy {
  flex-shrink: 0;
  padding: 2rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-bg);
  color: var(--color-primary);
  font-size: 24rpx;
}

.panel-poi-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
  text-align: center;
}

/* ── 详情区（全开态） ── */
.panel-poi-detail-wrap {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.panel-poi-detail {
  flex: 1;
  min-height: 0;
}

/* 封面：多图轮播 / 单图 / 分类占位 */
.poi-cover-swiper {
  width: 100%;
  height: 380rpx;
}

.poi-cover-img {
  width: 100%;
  height: 380rpx;
}

/* 无图占位：用品牌暖色而不是深蓝，避免和整站基调割裂 */
.poi-cover-placeholder {
  width: 100%;
  height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #FFF7E6, #FDE9C4);
}

.poi-cover-placeholder-text {
  font-size: 26rpx;
  color: var(--color-primary);
}

/* 深色模式下占位块不用浅色渐变，否则整块会发亮 */
.dark-theme .poi-cover-placeholder {
  background: linear-gradient(135deg, #3A2E15, #2A2418);
}
.dark-theme .poi-cover-placeholder-text {
  color: #E0A030;
}

.poi-dots {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: -32rpx;
  margin-bottom: 12rpx;
}

.poi-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  transition: all 0.22s ease-out;
}

.poi-dot.active {
  width: 32rpx;
  background: #fff;
}

/* 元信息 / 热度条 */
.poi-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 16rpx 28rpx 0;
}

.poi-indoor-tag {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: var(--font-weight-medium);
}

.poi-indoor-tag.indoor {
  background: var(--color-secondary-bg);
  color: var(--color-secondary);
}

.poi-indoor-tag.outdoor {
  background: rgba(46, 204, 113, 0.12);
  color: #27AE60;
}

.poi-heat-row {
  padding: 18rpx 20rpx;
  margin: 16rpx 28rpx;
  border-radius: 20rpx;
  background: var(--color-gray-50);
}

.poi-heat-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.poi-heat-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.poi-heat-num {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-bold);
}

.poi-heat-track {
  width: 100%;
  height: 12rpx;
  border-radius: var(--radius-pill);
  background: var(--color-gray-200);
  overflow: hidden;
}

.poi-heat-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, #F0B04A, #D4890E);
  transition: width 0.4s cubic-bezier(0.32, 0.72, 0, 1);
}

.poi-heat-fill.tone-hot { background: linear-gradient(90deg, #FF8A5B, #E84A3E); }
.poi-heat-fill.tone-warm { background: linear-gradient(90deg, #F7C25A, #F08C28); }
.poi-heat-fill.tone-calm { background: linear-gradient(90deg, #86D0A5, #4BA06E); }
.poi-heat-fill.tone-new { background: linear-gradient(90deg, #7FB6E8, #4A90D9); }

/* 外部地点收录状态（不显示热度，避免误以为已收录） */
.poi-status-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 16rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--color-gray-50);
}

.poi-status-text-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.poi-status-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.poi-status-desc {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* 地址已上移到概况区（.panel-poi-addr-row），详情区不再重复 */

/* 标签 / 设施 / 最佳时间 */
.poi-chip-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  padding: 0 28rpx 20rpx;
}

.poi-chip {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  background: var(--color-gray-100);
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.poi-chip.facility {
  background: rgba(91, 168, 26, 0.12);
  color: #5BA81A;
}

.poi-chip.time {
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

/* 收藏按钮：位于概况行右侧，可直接收藏无需进详情 */
.poi-fav-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-width: 120rpx;
  padding: 10rpx 16rpx;
  border-radius: 22rpx;
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-light);
  transition: all var(--duration-fast) var(--ease-out);
}

.poi-fav-btn.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.poi-fav-hover {
  transform: scale(0.94);
  opacity: 0.86;
}

.poi-fav-btn.pending {
  opacity: 0.6;
}

.poi-fav-text {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-semibold);
  line-height: 1.1;
}

.poi-fav-btn.active .poi-fav-text {
  color: #fff;
}

.poi-fav-count {
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.1;
}

.poi-fav-btn.active .poi-fav-count {
  color: rgba(255, 255, 255, 0.85);
}

/* 操作区固定在详情滚动区下方，两列换行布局，按钮与标签均不挤压换行 */
.poi-actions {
  flex-shrink: 0;
  /* 紧跟概况区排版：全开态由详情区（flex:1）把操作区压到面板底部，
     半开态详情区不渲染，操作区正好落在半开窗口内，不需要额外的钉底手段。 */
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-divider);
}

.poi-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  /* 一行放下 3-4 个入口；再多的（管理员）自动换行，不做横向滚动 */
  flex: 1 1 140rpx;
  min-width: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  height: 88rpx;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: var(--font-weight-semibold);
  white-space: nowrap;
  word-break: keep-all;
  flex-wrap: nowrap;
  transition: all var(--duration-fast) var(--ease-out);
}

.poi-btn.primary {
  background: var(--color-primary);
  color: #fff;
}

.poi-btn.secondary {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary-light);
}

.poi-btn:active {
  transform: scale(0.97);
  opacity: 0.85;
}

/* 未选中地点时的提示 */
.panel-poi-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
}

.panel-poi-empty-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
}


.map-fab-wrap {
  position: fixed;
  right: 32rpx;
  /* 页面视口不含原生 tabBar，bottom: 0 就是功能栏上沿。
     位置完全由面板可见高度驱动（--fab-panel-offset），始终贴着环境栏上沿。 */
  bottom: var(--fab-panel-offset, 200rpx);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 80;
  --fab-panel-offset: 200rpx;
  transition: bottom 0.36s var(--ease-emphasized);
  animation: cm-pop-in 0.44s var(--ease-spring) both;
}

/* 面板展开 / 折叠时 FAB 始终跟随到面板上沿；拖拽过程中去掉过渡以获得跟手感 */
.map-fab-wrap.dragging {
  transition: none;
}

.map-fab-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-bg-white);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform var(--duration-fast) var(--ease-spring), background-color var(--duration-fast) var(--ease-bezier), box-shadow var(--duration-fast) var(--ease-bezier);
}

.map-fab-btn.secondary {
  background: var(--color-bg-white);
}

/* 视角开关（我出过毛 / 我收藏的）激活态：实心琥珀，与未激活的白色区分 */
.map-fab-btn.active {
  background: var(--color-primary);
  box-shadow: 0 4px 20px rgba(212, 137, 14, 0.36);
}

.map-fab-btn:active {
  transform: scale(0.92);
}

.loading-more,
.no-more,
.empty-state {
  display: flex;
  justify-content: center;
  padding: var(--space-6) 0;
}

.loading-text,
.no-more-text {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
}

.empty-state {
  flex-direction: column;
  align-items: center;
  padding: var(--space-12) 0;
}

.empty-illustration {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 120rpx;
  margin-bottom: var(--space-4);
  background: var(--color-primary-bg, #FFF7E6);
  border-radius: 50%;
}

.empty-illustration-dots {
  position: absolute;
  right: -10rpx;
  bottom: 0;
  display: flex;
  gap: 6rpx;
  color: var(--color-primary, #D4890E);
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-3);
}

.empty-title {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.empty-desc {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
  margin-bottom: var(--space-5);
  text-align: center;
  padding: 0 var(--space-6);
}

.empty-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 40rpx;
  background: var(--color-primary, #D4890E);
  color: #fff;
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
  border-radius: var(--radius-button, 24px);
  box-shadow: 0 4px 16px rgba(212, 137, 14, 0.3);
}

.empty-action:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ── 出毛适宜度徽标（环境信息条内，点击看分项拆解） ── */
.env-fur { display: flex; align-items: center; gap: 8rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.7); }
.env-fur-dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.env-fur-text { font-size: 24rpx; font-weight: 600; color: var(--color-text-primary); white-space: nowrap; }

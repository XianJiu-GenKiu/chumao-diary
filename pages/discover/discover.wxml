<!-- 地图探索页 - 对齐 Figma 设计 -->
<view class="page page-discover {{darkMode ? 'dark-theme' : ''}}">

  <!-- 自定义顶部导航栏 -->
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <!-- 状态栏占位 -->
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <!-- 小程序标题 -->
    <view class="app-title">
      <text class="app-title-text">出毛日记</text>
      <view class="nav-quick-actions">
        <view class="nav-event-btn" bindtap="goSeasonal"><icon name="sun" size="36" color="#D4890E" /></view>
      </view>
    </view>
    <!-- 导航栏内容 -->
    <view class="nav-bar-content" style="height: {{navBarHeight}}px;">
      <!-- 头像入口 -->
      <view class="nav-avatar" bindtap="onAvatarTap">
        <image
          class="nav-avatar-img"
          wx:if="{{userInfo && (userInfo.avatar || userInfo.avatarUrl)}}"
          src="{{userInfo.avatar || userInfo.avatarUrl}}"
          mode="aspectFill"
        />
        <view class="nav-avatar-default" wx:else>
          <icon name="user" size="36" color="#999" />
        </view>
      </view>
      <!-- 搜索框：文案始终单行显示，不换行、不撑高 -->
      <view class="nav-search-bar" bindtap="onSearchTap">
        <icon name="search" size="32" color="#999" class="nav-search-icon" />
        <view class="nav-search-text-wrap">
          <text class="nav-search-placeholder">搜地点 · 有换装间、人少景美…</text>
        </view>
      </view>
      <!-- 城市选择器 + 定位 -->
      <view class="nav-city-wrap" bindtap="onCityTap">
        <icon name="map-pin" size="28" color="#D4890E" />
        <text class="nav-city-name">{{currentCity === '待定位' ? '点击定位' : currentCity}}</text>
        <text class="nav-city-arrow">▼</text>
      </view>
    </view>

    <!-- 精选地点抽屉：收起态只露滑动条，下拉展开精选地点列表。
         取代原先的「精选 / 全部 / 我出过毛 / 我收藏的」筛选标签栏：
         精选 → 本抽屉；我出过毛 / 我收藏的 → 地图右侧 FAB 列。 -->
    <view class="featured-drawer {{featuredExpanded ? 'expanded' : ''}} {{featuredDragging ? 'dragging' : ''}}">
      <!-- 列表在手柄上方，展开后手柄仍留在抽屉的下边框，随时可以上拉收起 -->
      <view class="featured-body" style="height: {{featuredBodyHeight}}px;">
        <scroll-view class="featured-scroll" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="featured-card"
            wx:for="{{featuredLocations}}"
            wx:key="_id"
            data-item="{{item}}"
            bindtap="onFeaturedTap"
          >
            <image class="featured-cover" src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images && item.images[0]}}" lazy-load />
            <view class="featured-cover featured-cover-placeholder" wx:else></view>
            <view class="featured-info">
              <text class="featured-name">{{item.name || '未命名地点'}}</text>
              <text class="featured-desc">{{item.serviceSummary}}</text>
              <view class="featured-loc"><icon name="map-pin" size="20" color="#D4890E" /><text>{{item.address || '运营方精选地点'}}</text></view>
            </view>
          </view>
          <view class="featured-empty" wx:if="{{!featuredLocations.length}}">
            <text class="featured-empty-text">运营方正在整理精选地点，敬请期待</text>
          </view>
        </scroll-view>
      </view>
      <view class="featured-handle"
        catchtouchstart="onFeaturedTouchStart"
        catchtouchmove="onFeaturedTouchMove"
        catchtouchend="onFeaturedTouchEnd"
        catchtouchcancel="onFeaturedTouchEnd"
        bindtap="onFeaturedToggle"
      >
        <view class="featured-handle-bar"></view>
        <view class="featured-handle-title">
          <icon name="star" size="26" color="#D4890E" />
          <text>精选地点</text>
          <text class="featured-handle-count" wx:if="{{featuredLocations.length}}">{{featuredLocations.length}}</text>
        </view>
        <icon name="chevron-down" size="26" color="#999" class="featured-handle-arrow {{featuredExpanded ? 'up' : ''}}" />
      </view>
    </view>
  </view>

  <!-- 地图地点加载失败提示：避免加载失败时标点静默消失、用户无法判断原因 -->
  <view class="map-load-error" wx:if="{{errorMessage}}" bindtap="onMapLoadRetry">
    <icon name="info" size="30" color="#D4890E" />
    <text class="map-load-error-text">{{errorMessage}}</text>
    <text class="map-load-error-retry">重新加载</text>
  </view>

  <!-- 城市选择浮层 -->
  <view class="city-panel-mask" wx:if="{{showCityPanel}}" bindtap="closeCityPanel"></view>
  <view class="city-panel {{showCityPanel ? 'show' : ''}}" wx:if="{{showCityPanel}}">
    <view class="city-panel-header">
      <text class="city-panel-title">选择城市</text>
      <text class="city-panel-close" bindtap="closeCityPanel">✕</text>
    </view>
    <!-- 城市搜索栏 -->
    <view class="city-search-bar">
      <input
        class="city-search-input"
        placeholder="搜索城市..."
        value="{{citySearchKeyword}}"
        bindinput="onCitySearchInput"
        bindconfirm="onCitySearchConfirm"
        focus="{{showCityPanel}}"
      />
      <icon name="search" size="28" color="#999" class="city-search-icon" />
    </view>
    <view class="city-panel-subtitle" wx:if="{{!citySearchKeyword}}">
      <!-- 定位入口：点击即由用户主动发起定位（启动时不自动索权） -->
      <view class="city-panel-subtitle-inner" bindtap="onReLocate">
        <icon name="map-pin" size="24" color="#D4890E" />
        <text wx:if="{{locatedCity && locatedCity !== '待定位' && locatedCity !== '定位失败'}}">当前定位：{{locatedCity}} · 点击重新定位</text>
        <text wx:else>未获取定位 · 点击定位</text>
      </view>
    </view>
    <view class="city-panel-content">
      <!-- 无搜索结果提示 -->
      <view class="city-empty-tip" wx:if="{{citySearchKeyword && filteredCityList.length === 0}}">
        <text>未找到匹配的城市</text>
      </view>
      <view
        class="city-panel-item {{currentCity === item.name ? 'active' : ''}}"
        wx:for="{{filteredCityList}}"
        wx:key="name"
        data-name="{{item.name}}"
        data-lat="{{item.lat}}"
        data-lng="{{item.lng}}"
        bindtap="onCitySelect"
      >
        <text class="city-panel-item-name">{{item.name}}</text>
        <view class="city-panel-item-location" wx:if="{{locatedCity === item.name && !citySearchKeyword}}"><icon name="map-pin" size="20" color="#D4890E" /><text>定位</text></view>
        <text class="city-panel-item-check" wx:if="{{currentCity === item.name}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 地图模式 -->
  <view class="map-mode">
    <!-- 地图区域（高度随面板状态变化） -->
    <view class="map-section">
      <map
        class="discover-map"
        latitude="{{mapLatitude}}"
        longitude="{{mapLongitude}}"
        scale="{{mapScale}}"
        markers="{{mapMarkers}}"
        bindmarkertap="onMarkerTap"
        bindregionchange="onMapRegionChange"
        bindtap="onMapTap"
        bindpoitap="onMapPoiTap"
        enable-drag
        enable-scroll
        enable-zoom
        show-location
        show-scale
      />
    </view>

    <!-- 地图模式 FAB 浮动按钮：贴着面板上沿，并随面板一起滑动。
         原先的「找场地」入口已移除，改为「我出过毛 / 我收藏的」两个视角开关，
         与定位按钮同列；点击后把对应地点标注到地图上，再点一次恢复全部。 -->
    <view class="map-fab-wrap {{mapFabDragging ? 'dragging' : ''}}" style="--fab-panel-offset: {{mapFabFollowOffset}}px;">
      <view class="map-fab-btn secondary {{viewMode === 'visited' ? 'active' : ''}}" bindtap="onFabVisited">
        <icon name="paw" size="38" color="{{viewMode === 'visited' ? '#fff' : '#D4890E'}}" />
      </view>
      <view class="map-fab-btn secondary {{viewMode === 'favored' ? 'active' : ''}}" bindtap="onFabFavored">
        <icon name="heart" size="38" color="{{viewMode === 'favored' ? '#fff' : '#D4890E'}}" />
      </view>
      <view class="map-fab-btn secondary" bindtap="moveToMyLocation">
        <icon name="map-pin" size="40" color="#D4890E" />
      </view>
    </view>

    <!-- 地点面板（三段式 bottom sheet）：概况 / 操作 / 详情按功能分区
         收起态：拖拽手柄 + 环境栏
         半开态：+ 地点概况（名称 / 距离 / 分类 / 地址）+ 操作区（已出毛 / 导航 / 详情 / 反馈）
         全开态：+ 详情区（封面 / 属性 / 热度 / 标签）
         操作区在收起 / 半开 / 全开三档都常驻面板底部，不随档位增减入口。
         高度与位移均由 JS 计算为 px 后内联，避免 CSS 变量在真机上的兼容问题。 -->
    <view class="float-panel {{mapPanelDragging ? 'dragging' : ''}}"
      style="height: {{panelFullHeight}}px; transform: translateY({{panelTranslate + mapPanelDragOffset}}px);"
    >
      <!-- 环境信息条固定在面板顶部，顶边与精选地点抽屉底边对齐；仍可拖动面板 -->
      <view class="env-bar"
        catchtouchstart="onPanelTouchStart"
        catchtouchmove="onPanelTouchMove"
        catchtouchend="onPanelTouchEnd"
        catchtouchcancel="onPanelTouchEnd"
      >

        <!-- 出毛适宜度：由温度/湿度/风力/天气本地计算，点击看分项拆解 -->
        <view class="env-fur" wx:if="{{weatherView.furIndex && weatherView.furIndex.ok}}" catchtap="onFurIndexTap">
          <view class="env-fur-dot" style="background: {{weatherView.furIndex.levelColor}};"></view>
          <text class="env-fur-text">{{weatherView.furIndex.levelLabel}} {{weatherView.furIndex.score}}</text>
        </view>
        <view class="env-dot" wx:if="{{weatherView.furIndex && weatherView.furIndex.ok}}"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.temperature || '—'}}</text>
          <text class="env-lbl">温度</text>
        </view>
        <view class="env-dot"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.humidity || '—'}}</text>
          <text class="env-lbl">湿度</text>
        </view>
        <view class="env-dot"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.wind || '—'}}</text>
          <text class="env-lbl">风力</text>
        </view>
        <view class="env-dot"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.condition || '—'}}</text>
          <text class="env-lbl">天气</text>
        </view>
      </view>

      <!-- 拖拽手柄放在环境栏之后：上边环境栏可以贴齐顶部抽屉，手柄仍可控制面板 -->
      <view class="panel-handle"
        catchtouchstart="onPanelTouchStart"
        catchtouchmove="onPanelTouchMove"
        catchtouchend="onPanelTouchEnd"
        catchtouchcancel="onPanelTouchEnd"
      >
        <view class="handle-bar"></view>
      </view>

      <!-- 地点信息区 -->
      <block wx:if="{{selectedPoi}}">
        <!-- ① 概况区：任何档位都可见，只放「这是什么地方」 -->
        <view class="panel-poi-head">
          <view class="panel-poi-title-row">
            <text class="panel-poi-name">{{selectedPoi.name || '未命名地点'}}</text>
            <!-- 收藏：仅内部地点可用，面板内直接收藏无需进详情 -->
            <view
              wx:if="{{selectedPoi.canFavorite}}"
              class="poi-fav-btn {{selectedPoi.isFavorited ? 'active' : ''}} {{favPending ? 'pending' : ''}}"
              hover-class="poi-fav-hover"
              hover-stay-time="80"
              catchtap="onPoiFavorite"
            >
              <icon name="{{selectedPoi.isFavorited ? 'heart' : 'heart-outline'}}" size="36" color="{{selectedPoi.isFavorited ? '#fff' : '#D4890E'}}" fill="{{selectedPoi.isFavorited}}" />
              <text class="poi-fav-text">{{selectedPoi.isFavorited ? '已收藏' : '收藏'}}</text>
              <text class="poi-fav-count">{{selectedPoi.favoriteCount || 0}}</text>
            </view>
          </view>
          <view class="panel-poi-subline">
            <text class="poi-distance" wx:if="{{selectedPoi.distance}}">{{selectedPoi.distance}}</text>
            <text class="poi-category-tag" wx:if="{{selectedPoi.categoryName}}">{{selectedPoi.categoryName}}</text>
            <text class="poi-uncollected-tag" wx:if="{{selectedPoi.collectionStatus !== 'collected'}}">暂未收录</text>
          </view>
          <!-- 地址属于概况信息，各档位都可复制，不重复出现在详情里 -->
          <view class="panel-poi-addr-row" wx:if="{{selectedPoi.address}}">
            <icon name="map-pin" size="24" color="#909090" />
            <text class="panel-poi-addr-text">{{selectedPoi.address}}</text>
            <text class="panel-poi-copy" catchtap="onPoiCopyAddress">复制</text>
          </view>
          <text class="panel-poi-hint" wx:if="{{mapPanelState !== 'full'}}"
            catchtouchstart="onPanelTouchStart"
            catchtouchmove="onPanelTouchMove"
            catchtouchend="onPanelTouchEnd"
            catchtouchcancel="onPanelTouchEnd"
          >上滑查看详情</text>
        </view>

        <!-- ② 详情区：仅全开态展开，收起态不占位（否则半开面板底部会留一大块空白） -->
        <view class="panel-poi-detail-wrap" wx:if="{{mapPanelState === 'full'}}">
          <scroll-view class="panel-poi-detail" scroll-y enhanced show-scrollbar="{{false}}">
            <!-- 封面：多图轮播 / 单图 / 分类占位 -->
            <block wx:if="{{poiGallery.length > 1}}">
              <swiper
                class="poi-cover-swiper"
                circular
                current="{{poiCurrentImage}}"
                bindchange="onPoiGalleryChange"
                duration="260"
                easing-function="easeOutCubic"
              >
                <swiper-item wx:for="{{poiGallery}}" wx:for-item="imgUrl" wx:key="*this">
                  <image class="poi-cover-img" src="{{imgUrl}}" mode="aspectFill" bindtap="onPoiPreviewImage" />
                </swiper-item>
              </swiper>
              <view class="poi-dots">
                <view wx:for="{{poiGallery}}" wx:key="*this" class="poi-dot {{poiCurrentImage === index ? 'active' : ''}}"></view>
              </view>
            </block>
            <image
              wx:elif="{{poiGallery.length === 1}}"
              class="poi-cover-img"
              src="{{poiGallery[0]}}"
              mode="aspectFill"
              bindtap="onPoiPreviewImage"
            />
            <view class="poi-cover-placeholder" wx:else>
              <icon name="{{selectedPoi.placeholderIcon || 'map-pin'}}" size="64" color="#D4890E" />
              <text class="poi-cover-placeholder-text">{{selectedPoi.categoryName || '这个地点还没有照片'}}</text>
            </view>

            <!-- 内部地点：属性 + 热度条 -->
            <block wx:if="{{!selectedPoi.isExternalPoi}}">
              <view class="poi-meta-row">
                <view class="poi-indoor-tag {{selectedPoi.isIndoor ? 'indoor' : 'outdoor'}}">
                  <icon name="{{selectedPoi.isIndoor ? 'home' : 'sun'}}" size="26" />
                  <text>{{selectedPoi.isIndoor ? '室内' : '室外'}}</text>
                </view>
              </view>
              <view class="poi-heat-row">
                <view class="poi-heat-head">
                  <icon name="trending-up" size="26" color="#D4890E" />
                  <text class="poi-heat-title">地点热度</text>
                  <text class="poi-heat-num">{{selectedPoi.heat}}</text>
                </view>
                <view class="poi-heat-track">
                  <view class="poi-heat-fill tone-{{selectedPoi.heatTone}}" style="width: {{selectedPoi.heatPercent}}%;"></view>
                </view>
              </view>
            </block>

            <!-- 外部地点：收录状态说明（不显示热度，避免误以为已收录） -->
            <view class="poi-status-row" wx:else>
              <icon name="{{selectedPoi.collectionStatus === 'unresolved' ? 'info' : 'compass'}}" size="28" color="#909090" />
              <view class="poi-status-text-wrap">
                <text class="poi-status-title">{{selectedPoi.collectionStatus === 'unresolved' ? '地图上暂无该地点信息' : '出毛日记暂未收录此地'}}</text>
                <text class="poi-status-desc">点「反馈」把信息给运营方，核对后即可收录</text>
              </view>
            </view>

            <!-- 标签 / 设施 / 最佳时间（仅内部地点） -->
            <view class="poi-chip-row" wx:if="{{!selectedPoi.isExternalPoi && (selectedPoi.tags.length || selectedPoi.facilities.length || selectedPoi.bestTime)}}">
              <text class="poi-chip" wx:for="{{selectedPoi.tags}}" wx:for-item="tagName" wx:key="*this">{{tagName}}</text>
              <view class="poi-chip facility" wx:for="{{selectedPoi.facilities}}" wx:for-item="facilityName" wx:key="*this">
                <icon name="check" size="22" color="#5BA81A" />
                <text>{{facilityName}}</text>
              </view>
              <view class="poi-chip time" wx:if="{{selectedPoi.bestTime}}">
                <icon name="clock" size="22" color="#D4890E" />
                <text>最佳 {{selectedPoi.bestTime}}</text>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- ③ 操作区：任何档位都常驻在面板底部，按「先记录、再导航、后纠错」排序 -->
        <view class="poi-actions">
          <view class="poi-btn primary" catchtap="onPoiMarkVisited">
            <icon name="paw" size="30" color="#fff" />
            <text>已出毛</text>
          </view>
          <view class="poi-btn secondary" wx:if="{{selectedPoi.canNavigate}}" catchtap="onPoiNavigate">
            <icon name="navigation" size="30" color="#D4890E" />
            <text>导航</text>
          </view>
          <view class="poi-btn secondary" wx:if="{{selectedPoi.canViewDetail}}" catchtap="onPoiViewDetail">
            <icon name="info" size="30" color="#D4890E" />
            <text>详情</text>
          </view>
          <!-- 反馈此地点：对所有地点开放（已收录的也可反馈纠错），帮助运营方核对 -->
          <view class="poi-btn secondary" catchtap="onPoiFeedback">
            <icon name="edit" size="30" color="#D4890E" />
            <text>反馈</text>
          </view>
          <view class="poi-btn secondary" wx:if="{{isAdmin && selectedPoi.canAddToDiary}}" catchtap="onPoiAddToDiary">
            <icon name="plus" size="30" color="#D4890E" />
            <text>录入</text>
          </view>
        </view>
      </block>

      <!-- 未选中地点时的提示（仅在面板被拉起时才可能看到） -->
      <view class="panel-poi-empty" wx:else>
        <icon name="map-pin" size="56" color="#ddd" />
        <text class="panel-poi-empty-text">点击地图上的地点查看详情</text>
      </view>
    </view>
  </view>

  <privacy-popup />
</view>

<!-- 地图探索页 - 对齐 Figma 设计 -->
<view class="page page-discover {{darkMode ? 'dark-theme' : ''}}">

  <!-- 自定义顶部导航栏 -->
  <view class="custom-nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <!-- 状态栏占位 -->
    <view class="status-bar-placeholder" style="height: {{statusBarHeight}}px;"></view>
    <!-- 小程序标题 -->
    <view class="app-title">
      <text class="app-title-text">出毛日记</text>
      <view class="nav-quick-actions">
        <view class="nav-event-btn" bindtap="goSeasonal"><icon name="sun" size="36" color="#D4890E" /></view>
      </view>
    </view>
    <!-- 导航栏内容 -->
    <view class="nav-bar-content" style="height: {{navBarHeight}}px;">
      <!-- 头像入口 -->
      <view class="nav-avatar" bindtap="onAvatarTap">
        <image
          class="nav-avatar-img"
          wx:if="{{userInfo && (userInfo.avatar || userInfo.avatarUrl)}}"
          src="{{userInfo.avatar || userInfo.avatarUrl}}"
          mode="aspectFill"
        />
        <view class="nav-avatar-default" wx:else>
          <icon name="user" size="36" color="#999" />
        </view>
      </view>
      <!-- 搜索框：文案始终单行显示，不换行、不撑高 -->
      <view class="nav-search-bar" bindtap="onSearchTap">
        <icon name="search" size="32" color="#999" class="nav-search-icon" />
        <view class="nav-search-text-wrap">
          <text class="nav-search-placeholder">搜地点 · 有换装间、人少景美…</text>
        </view>
      </view>
      <!-- 城市选择器 + 定位 -->
      <view class="nav-city-wrap" bindtap="onCityTap">
        <icon name="map-pin" size="28" color="#D4890E" />
        <text class="nav-city-name">{{currentCity}}</text>
        <text class="nav-city-arrow">▼</text>
      </view>
    </view>

  <!-- 固定在搜索栏底部的视角快切栏：精选 / 全部 / 我出过毛 / 我收藏的 -->
  <view class="fixed-top-bar">
    <view class="filter-section">
      <view class="filter-container">
        <view class="filter-list">
          <block wx:for="{{viewOptions}}" wx:key="key">
            <view
              class="filter-tag {{viewMode === item.key ? 'active' : ''}}"
              data-view="{{item.key}}"
              bindtap="onViewTap"
            >
              <icon name="{{item.icon}}" size="22" color="{{viewMode === item.key ? '#fff' : '#D4890E'}}" />
              <text>{{item.name}}</text>
            </view>
          </block>
        </view>
        <!-- 地点计数（不可点击，仅展示当前视角的地点数量） -->
        <view class="filter-all-btn static">
          <text>{{viewCount}} 个</text>
        </view>
      </view>
    </view>
  </view>
  </view>
  <!-- 地图地点加载失败提示：避免加载失败时标点静默消失、用户无法判断原因 -->
  <view class="map-load-error" wx:if="{{errorMessage}}" bindtap="onMapLoadRetry">
    <icon name="info" size="30" color="#D4890E" />
    <text class="map-load-error-text">{{errorMessage}}</text>
    <text class="map-load-error-retry">重新加载</text>
  </view>

  <!-- 城市选择浮层 -->
  <view class="city-panel-mask" wx:if="{{showCityPanel}}" bindtap="closeCityPanel"></view>
  <view class="city-panel {{showCityPanel ? 'show' : ''}}" wx:if="{{showCityPanel}}">
    <view class="city-panel-header">
      <text class="city-panel-title">选择城市</text>
      <text class="city-panel-close" bindtap="closeCityPanel">✕</text>
    </view>
    <!-- 城市搜索栏 -->
    <view class="city-search-bar">
      <input
        class="city-search-input"
        placeholder="搜索城市..."
        value="{{citySearchKeyword}}"
        bindinput="onCitySearchInput"
        bindconfirm="onCitySearchConfirm"
        focus="{{showCityPanel}}"
      />
      <icon name="search" size="28" color="#999" class="city-search-icon" />
    </view>
    <view class="city-panel-subtitle" wx:if="{{!citySearchKeyword}}">
      <view class="city-panel-subtitle-inner"><icon name="map-pin" size="24" color="#D4890E" /><text>当前定位：{{locatedCity || '定位中...'}}</text></view>
    </view>
    <view class="city-panel-content">
      <!-- 无搜索结果提示 -->
      <view class="city-empty-tip" wx:if="{{citySearchKeyword && filteredCityList.length === 0}}">
        <text>未找到匹配的城市</text>
      </view>
      <view
        class="city-panel-item {{currentCity === item.name ? 'active' : ''}}"
        wx:for="{{filteredCityList}}"
        wx:key="name"
        data-name="{{item.name}}"
        data-lat="{{item.lat}}"
        data-lng="{{item.lng}}"
        bindtap="onCitySelect"
      >
        <text class="city-panel-item-name">{{item.name}}</text>
        <view class="city-panel-item-location" wx:if="{{locatedCity === item.name && !citySearchKeyword}}"><icon name="map-pin" size="20" color="#D4890E" /><text>定位</text></view>
        <text class="city-panel-item-check" wx:if="{{currentCity === item.name}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 地图模式 -->
  <view class="map-mode">
    <!-- 地图区域（高度随面板状态变化） -->
    <view class="map-section">
      <map
        class="discover-map"
        latitude="{{mapLatitude}}"
        longitude="{{mapLongitude}}"
        scale="{{mapScale}}"
        markers="{{mapMarkers}}"
        bindmarkertap="onMarkerTap"
        bindregionchange="onMapRegionChange"
        bindtap="onMapTap"
        bindpoitap="onMapPoiTap"
        enable-drag
        enable-scroll
        enable-zoom
        show-location
        show-scale
      >
        <!-- map 原生层之上的地点缩略浮层，必须使用 cover-view 才能稳定显示。 -->
        <cover-view
          class="map-poi-mini"
          wx:if="{{showPoiMini && selectedPoi}}"
          style="top: {{mapPoiMiniTop}}px; transform: scale({{poiMiniScale}});"
          bindtap="onOpenPoiPreview"
        >
          <cover-image class="map-poi-mini-cover" wx:if="{{selectedPoi.previewImage}}" src="{{selectedPoi.previewImage}}" />
          <cover-view class="map-poi-mini-cover map-poi-mini-placeholder" wx:else>地点</cover-view>
          <cover-view class="map-poi-mini-content">
            <cover-view class="map-poi-mini-name">{{selectedPoi.name || '未命名地点'}}</cover-view>
            <cover-view class="map-poi-mini-meta">{{selectedPoi.miniMeta}}</cover-view>
          </cover-view>
          <cover-view class="map-poi-mini-arrow">详情</cover-view>
        </cover-view>
      </map>
    </view>

    <!-- 地图模式 FAB 浮动按钮：贴着环境栏上沿，并随面板一起滑动 -->
    <view class="map-fab-wrap {{mapPanelExpanded ? 'panel-expanded' : 'collapsed'}} {{mapFabDragging ? 'dragging' : ''}}" style="--fab-panel-offset: {{mapFabFollowOffset}}px;">
      <view class="map-fab-btn secondary map-fab-finder" bindtap="onOpenSiteFinder">
        <icon name="compass" size="40" color="#D4890E" />
      </view>
      <view class="map-fab-btn secondary map-fab-locate" bindtap="moveToMyLocation">
        <icon name="map-pin" size="40" color="#D4890E" />
      </view>
    </view>

    <!-- 浮动面板（附近动态） -->
    <view class="float-panel {{mapPanelExpanded ? 'expanded' : 'collapsed'}} {{mapPanelDragging ? 'dragging' : ''}}" style="--panel-drag-offset: {{mapPanelDragOffset}}px;">
      <!-- 拖拽手柄 -->
      <view class="panel-handle"
        catchtouchstart="onPanelTouchStart"
        catchtouchmove="onPanelTouchMove"
        catchtouchend="onPanelTouchEnd"
        catchtouchcancel="onPanelTouchEnd"
      >
        <view class="handle-bar"></view>
      </view>
      <!-- 环境信息条：固定在面板顶部，不参与滚动，避免下划后被裁切 -->
      <view class="env-bar"
        bindtouchstart="onPanelTouchStart"
        bindtouchmove="onPanelTouchMove"
        bindtouchend="onPanelTouchEnd"
        bindtouchcancel="onPanelTouchEnd"
      >
        <!-- 出毛适宜度：由温度/湿度/风力/天气本地计算，点击看分项拆解 -->
        <view class="env-fur" wx:if="{{weatherView.furIndex && weatherView.furIndex.ok}}" bindtap="onFurIndexTap">
          <view class="env-fur-dot" style="background: {{weatherView.furIndex.levelColor}};"></view>
          <text class="env-fur-text">{{weatherView.furIndex.levelLabel}} {{weatherView.furIndex.score}}</text>
        </view>
        <view class="env-dot" wx:if="{{weatherView.furIndex && weatherView.furIndex.ok}}"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.temperature || '—'}}</text>
          <text class="env-lbl">温度</text>
        </view>
        <view class="env-dot"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.humidity || '—'}}</text>
          <text class="env-lbl">湿度</text>
        </view>
        <view class="env-dot"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.wind || '—'}}</text>
          <text class="env-lbl">风力</text>
        </view>
        <view class="env-dot"></view>
        <view class="env-item-sm">
          <text class="env-val">{{weatherView.condition || '—'}}</text>
          <text class="env-lbl">天气</text>
        </view>
      </view>
      <scroll-view class="panel-scroll" scroll-y enhanced show-scrollbar="{{false}}">
        <!-- 精选推荐：运营方标记 featured 的地点（见 location-upload 的精选开关） -->
        <view class="panel-section-head">
          <text class="panel-section-title">精选推荐</text>
          <text class="panel-section-sub">运营方发布的精选地点</text>
        </view>
        <!-- 精选地点列表：点击进入 POI 详情，可继续查看周边服务 -->
        <view class="panel-post-card panel-location-card"
          wx:for="{{nearbyLocations}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="onNearbyTap"
        >
          <image class="panel-post-cover" src="{{item.images[0]}}" mode="aspectFill" wx:if="{{item.images && item.images[0]}}" lazy-load />
          <view class="panel-post-cover panel-post-placeholder" wx:else></view>
          <view class="panel-post-info">
            <text class="panel-location-name">{{item.name || '未命名地点'}}</text>
            <text class="panel-post-text">{{item.serviceSummary}}</text>
            <view class="panel-post-loc"><icon name="map-pin" size="20" color="#D4890E" /><text>{{item.address || '运营方精选地点'}}</text></view>
          </view>
        </view>
        <view class="panel-empty" wx:if="{{nearbyLocations.length === 0}}">
          <text class="panel-empty-text">运营方正在整理精选地点，敬请期待</text>
        </view>
      </scroll-view>
    </view>
  </view>

    <!-- POI 预览卡片（地图模式点击 marker 后显示） -->
  <poi-preview-card
    item="{{selectedPoi}}"
    visible="{{showPoiPreview}}"
    placement="floating"
    top="{{poiCardTop}}"
    bind:viewDetail="onViewPoiDetail"
    bind:navigate="onNavigateToPoi"
    bind:favorite="onTogglePoiFavorite"
    bind:nearbyServices="onNearbyServices"
    show-add="{{isAdmin}}"
    bind:addToDiary="onAddExternalPoi"
    bind:markVisited="onMarkVisitedFromPoi"
    bind:close="onClosePoiPreview"
  />

</view>

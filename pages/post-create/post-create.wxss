@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

/* ── 自定义导航栏 ──────────────────────────────────────────
   原生导航栏标题字号由微信固定（约 17px）且不可配置，
   因此本页改用 navigationStyle: custom，自行绘制导航栏，
   把「发帖」放大到 40rpx（20px）并与页面其他标题层级统一。 */
.create-nav {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--color-bg-white);
  border-bottom: 1rpx solid var(--color-divider);
  box-sizing: border-box;
}

.create-nav-inner {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.create-nav-back,
.create-nav-placeholder {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.create-nav-back:active {
  background: var(--color-gray-100);
  border-radius: 50%;
}

.create-nav-back text {
  font-size: 60rpx;
  font-weight: 300;
  line-height: 0.8;
  color: var(--color-text-primary);
}

/* 标题：40rpx（20px），比原生导航栏明显更大 */
.create-nav-title {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-text-primary);
}

/* 发帖页字号整体上调一档：正文 30rpx（15px）、标题 32rpx（16px）、
   辅助说明 26rpx（13px）。原实现大量使用 14px 以下字号，在手机上偏小。 */
.page-create {
  /* 顶部内边距交给自定义导航栏，避免双重留白 */
  padding: 0 var(--space-4) var(--space-4);
  /* 底部预留固定发布栏高度 + 安全区，避免最后一块内容被发布栏压住 */
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  min-height: 100vh;
}

/* ── 通用区块 ── */
.section {
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  margin-bottom: var(--space-3);
}

/* 导航栏下方留出间距（页面顶部内边距已交给导航栏） */
.create-nav + .section {
  margin-top: var(--space-3);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 32rpx;
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.section-hint {
  font-size: 26rpx;
  color: var(--color-text-hint);
}

/* ── 关联地点 ── */
.location-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 2rpx dashed var(--color-gray-300);
  border-radius: var(--radius-md);
  background: var(--color-gray-50);
}

.location-picker:active {
  background: var(--color-gray-100);
}

.location-placeholder {
  font-size: 30rpx;
  color: var(--color-text-hint);
}

.location-selected {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--space-3);
  background: var(--color-primary-bg);
  border-radius: var(--radius-md);
}

.location-name {
  font-size: 30rpx;
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

.location-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  min-height: 72rpx;
  font-size: var(--text-lg);
  color: var(--color-text-hint);
}

/* ── 图片网格 ── */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 64rpx;
  height: 64rpx;
  background: rgba(0, 0, 0, 0.5);
  color: var(--color-text-inverse);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-xs);
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--color-gray-300);
  border-radius: var(--radius-md);
  background: var(--color-gray-50);
}

.image-add:active {
  background: var(--color-gray-100);
}

.image-add-icon {
  font-size: 60rpx;
  color: var(--color-text-hint);
  line-height: 1;
}

.image-add-text {
  font-size: 26rpx;
  color: var(--color-text-hint);
  margin-top: var(--space-1);
}

/* ── 心情网格 ── */
/* 8 个心情按 4 列排布，格子加大以容纳兽头图标与更大的文字 */
.mood-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.mood-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 12rpx);
  min-height: 160rpx;
  padding: 14rpx 4rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  background: var(--color-gray-50);
  border: 2rpx solid transparent;
  transition: all var(--duration-fast) var(--ease-out);
}

.mood-item:active {
  transform: scale(0.95);
}

.mood-active {
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary);
}

.mood-icon {
  display: block;
  line-height: 0;
  /* 图标为彩色固定配色，选中态不再靠换色表达，
     改用「放大 + 底色 + 描边」三重反馈，弱色盲用户也能分辨 */
  transition: transform var(--duration-fast) var(--ease-out);
}

.mood-active .mood-icon {
  transform: scale(1.12);
}

.mood-label {
  font-size: 25rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
  text-align: center;
  line-height: 1.3;
}

.mood-active .mood-label {
  color: var(--color-primary);
  font-weight: var(--font-weight-medium);
}

/* ── 标签 ── */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  height: 60rpx;
  padding: 0 var(--space-3);
  font-size: 26rpx;
}

.tag-remove {
  font-size: 26rpx;
  margin-left: var(--space-1);
  opacity: 0.6;
}

.tag-remove:active {
  opacity: 1;
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.tag-input {
  flex: 1;
  height: 80rpx;
  padding: 0 var(--space-3);
  background: var(--color-gray-100);
  border-radius: var(--radius-md);
  font-size: 30rpx;
}

.tag-add-btn {
  flex-shrink: 0;
  height: 80rpx;
  font-size: 28rpx;
}

/* ── 发布按钮 ── */
.publish-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--space-3) var(--space-4);
  padding-bottom: calc(var(--space-3) + env(safe-area-inset-bottom));
  background: var(--color-bg-white);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.publish-btn {
  height: 92rpx;
  font-size: 34rpx;
}

/* ── 切换行（可见性） ── */
.toggle-row {
  display: flex;
  gap: var(--space-2);
}
.toggle-item {
  flex: 1;
  padding: var(--space-3);
  text-align: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 30rpx;
}
.toggle-item.active {
  border-color: var(--color-primary);
  background: var(--color-primary-bg);
  color: var(--color-primary);
}

/* ── 可见性说明 ──
   原实现把这段说明直接放在 toggle-row 之后，被固定定位的发布栏遮住；
   现改为独立说明块（图标 + 多行文字），页面底部也已预留足够空间。 */
.visibility-note {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: var(--space-3);
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  background: var(--color-gray-50);
}

.visibility-note-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-hint);
}

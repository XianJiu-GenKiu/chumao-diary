@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page{min-height:100vh;background:var(--color-bg-page);padding-bottom:40rpx}.hero{display:flex;flex-direction:column;gap:8rpx;padding:40rpx 32rpx;background:var(--color-primary-bg);color:var(--color-text-secondary)}.tag{font-size: 44rpx;font-weight:700;color:var(--color-primary)}.section{padding:24rpx 24rpx 0}.title{display:block;font-size:30rpx;font-weight:600;margin-bottom:16rpx}.card{background:var(--color-bg-card);border-radius:16rpx;padding:20rpx;margin-bottom:16rpx}.location{display:flex;gap:16rpx}.location image{width:140rpx;height:110rpx;border-radius:10rpx;flex-shrink:0}.name,.content{display:block;font-size:28rpx;color:var(--color-text-primary)}.desc,.meta{display:block;margin-top:10rpx;font-size:24rpx;color:var(--color-text-secondary)}.post image{width:100%;height:280rpx;border-radius:10rpx;margin-top:14rpx}.state{text-align:center;padding:60rpx 24rpx;color:var(--color-text-hint)}

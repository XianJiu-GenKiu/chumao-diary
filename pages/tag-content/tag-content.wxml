<view class="page">
  <view class="hero"><text class="tag">#{{tag}}</text><text>相关动态和地点</text></view>
  <error-state visible="{{!!errorMessage && !loading && posts.length === 0 && locations.length === 0}}" message="{{errorMessage}}" bind:retry="onRetry" />
  <view class="section" wx:if="{{locations.length}}"><text class="title">相关地点</text><view class="card location" wx:for="{{locations}}" wx:key="_id" data-id="{{item._id}}" bindtap="onLocationTap"><image wx:if="{{item.images && item.images.length}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load /><view><text class="name">{{item.name}}</text><text class="desc">{{item.address || item.description}}</text></view></view></view>
  <view class="section" wx:if="{{posts.length}}"><text class="title">相关动态</text><view class="card post" wx:for="{{posts}}" wx:key="_id" data-id="{{item._id}}" bindtap="onPostTap"><text class="content">{{item.content}}</text><image wx:if="{{item.images && item.images.length}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load /><text class="meta">{{item.authorName || '用户'}} · {{item.timeText}}</text></view></view>
  <view class="state" wx:if="{{loading}}">加载中…</view><view class="state" wx:if="{{!loading && !errorMessage && !posts.length && !locations.length}}">暂无相关内容</view><view class="state" wx:if="{{!loading && !hasMore && posts.length}}">没有更多内容了</view>
</view>

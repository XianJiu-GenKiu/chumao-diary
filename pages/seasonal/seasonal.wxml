<view class="page"><view class="hero" wx:if="{{season}}"><text class="title">{{season}}出行推荐</text><text>根据地点标签、季节说明和社区内容精选</text></view><view class="card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="onItemTap"><image class="cover" wx:if="{{item.images && item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load /><view class="info"><text class="name">{{item.name}}</text><text class="desc">{{item.description || item.address || '适合本季节出行'}}</text><text class="tag">{{item.season || season}}</text></view></view><view class="state" wx:if="{{loading}}">加载中...</view><view class="state" wx:if="{{!loading && error}}"><text>{{error}}</text><text bindtap="onRetry">重试</text></view><view class="state" wx:if="{{!loading && !error && list.length === 0}}">暂未找到适合{{season || '当前'}}季节的地点</view></view>

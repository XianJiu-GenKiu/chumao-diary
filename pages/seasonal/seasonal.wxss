@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page{min-height:100vh;background:#f7f8fa;padding:24rpx;box-sizing:border-box}.hero{display:flex;flex-direction:column;gap:10rpx;padding:36rpx 28rpx;margin-bottom:20rpx;border-radius:20rpx;background:linear-gradient(135deg,#fff3df,#fff);color:#8c6b2d;font-size: 26rpx}.title{font-size: 36rpx;font-weight:700;color:#b47108}.card{display:flex;gap:20rpx;padding:18rpx;margin-bottom:16rpx;background:#fff;border-radius:16rpx}.cover{width:160rpx;height:160rpx;border-radius:12rpx;background:#eee}.info{display:flex;flex:1;min-width:0;flex-direction:column;gap:12rpx}.name{font-size:30rpx;font-weight:600;color:#222}.desc{font-size:24rpx;color:#777;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.tag{font-size: 24rpx;color:#d4890e}.state{padding:140rpx 24rpx;text-align:center;color:#999}.state text:last-child{display:block;margin-top:18rpx;color:#d4890e}

<!-- 活动列表页 -->
<view class="page-events {{darkMode ? 'dark-theme' : ''}}">

  <!-- 导航 -->
  <view class="events-nav" style="padding-top: {{navBarHeight}}px;">
    <view class="nav-title">活动聚会</view>
    <view class="nav-create" bindtap="goCreate">
      <icon name="plus-circle" size="36" color="#D4890E" />
    </view>
  </view>

  <!-- 状态筛选 -->
  <view class="filter-tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="filter-tab {{currentTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </view>

  <!-- 活动列表 -->
  <scroll-view
    class="event-list"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscrolltolower="loadMore"
  >
    <view
      wx:for="{{list}}"
      wx:key="_id"
      class="event-card"
      bindtap="goDetail"
      data-id="{{item._id}}"
    >
      <!-- 封面图 -->
      <view class="card-cover">
        <image
          wx:if="{{item.cover}}"
          src="{{item.cover}}"
          mode="aspectFill"
          class="cover-img"
          lazy-load
        />
        <view wx:else class="cover-placeholder">
          <icon name="calendar" size="48" color="rgba(255,255,255,0.3)" />
        </view>
        <!-- 状态徽章 -->
        <view class="event-status {{item.status === 'upcoming' ? 'upcoming' : item.status === 'ongoing' ? 'ongoing' : 'ended'}}">
          {{item.status === 'upcoming' ? '即将开始' : item.status === 'ongoing' ? '进行中' : '已结束'}}
        </view>
        <!-- 人数 -->
        <view class="event-capacity">
          <icon name="users" size="24" color="#fff" />
          <text>{{item.joinCount || 0}}/{{item.maxPeople || '∞'}}</text>
        </view>
      </view>

      <!-- 信息 -->
      <view class="card-info">
        <view class="event-name">{{item.name}}</view>

        <view class="event-meta">
          <view class="meta-item">
            <icon name="clock" size="24" color="#909090" />
            <text>{{item.formattedTime}}</text>
          </view>
          <view class="meta-item">
            <icon name="map-pin" size="24" color="#909090" />
            <text>{{item.location || '待定'}}</text>
          </view>
        </view>

        <view class="card-footer">
          <!-- 参与者头像 -->
          <view class="participants">
            <image
              wx:for="{{item.recentParticipants}}"
              wx:for-item="p"
              wx:key="*this"
              src="{{p}}"
              mode="aspectFill"
              class="participant-avatar"
            />
            <view wx:if="{{item.remainingCount > 0}}" class="remaining-count">
              +{{item.remainingCount}}
            </view>
          </view>

          <view class="event-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="t">{{t}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <view class="loading-dot"></view>
      <text>加载中…</text>
    </view>

    <!-- 错误状态：不要把接口故障误显示成空列表 -->
    <view class="empty-state" wx:if="{{!loading && errorMessage}}">
      <icon name="alert-circle" size="80" color="#D4890E" />
      <text class="empty-text">{{errorMessage}}</text>
      <view class="empty-action" bindtap="retryLoad">
        <icon name="refresh-cw" size="32" color="#D4890E" />
        <text>重新加载</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && !errorMessage && list.length === 0}}">
      <icon name="calendar" size="80" color="#ccc" />
      <text class="empty-text">暂无{{currentTabLabel}}活动</text>
      <view class="empty-action" bindtap="goCreate">
        <icon name="plus-circle" size="32" color="#D4890E" />
        <text>发布活动</text>
      </view>
    </view>
  </scroll-view>

  <!-- 回到顶部 -->
  <view class="back-top {{showBackTop ? 'show' : ''}}" bindtap="scrollToTop">
    <icon name="chevron-up" size="36" color="#fff" />
  </view>
</view>

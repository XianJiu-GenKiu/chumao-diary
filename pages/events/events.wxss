@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

/* ── 页面 ── */
.page-events {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ── 导航 ── */
.events-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx var(--page-padding);
  background: var(--color-surface);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
}

.nav-create {
  padding: 8rpx;
  display: flex;
  align-items: center;
}

.nav-create:active {
  opacity: 0.7;
  transform: scale(0.92);
}

/* ── 筛选 Tab ── */
.filter-tabs {
  display: flex;
  gap: 12rpx;
  padding: 20rpx var(--page-padding);
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
}

.filter-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
  background: var(--color-bg);
  transition: all var(--duration-fast);
}

.filter-tab.active {
  color: #fff;
  background: var(--color-primary);
}

/* ── 列表 ── */
.event-list {
  height: calc(100vh - 260rpx);
  padding: 20rpx var(--page-padding);
}

.event-card {
  background: var(--color-surface);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform var(--duration-fast);
}

.event-card:active {
  transform: scale(0.985);
}

/* ── 封面 ── */
.card-cover {
  position: relative;
  height: 280rpx;
  background: linear-gradient(135deg, #2D3A54, #1A2A44);
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.event-status {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.event-status.upcoming {
  background: rgba(46, 204, 113, 0.85);
}

.event-status.ongoing {
  background: rgba(212, 137, 14, 0.85);
}

.event-status.ended {
  background: rgba(149, 165, 166, 0.85);
}

.event-capacity {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
}

/* ── 信息区 ── */
.card-info {
  padding: 24rpx;
}

.event-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 16rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.event-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ── 底部 ── */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

.participants {
  display: flex;
  align-items: center;
}

.participant-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: -10rpx;
  border: 2rpx solid var(--color-surface);
}

.remaining-count {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-bg);
  color: var(--color-text-hint);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 4rpx;
  border: 2rpx solid var(--color-surface);
}

.event-tags {
  display: flex;
  gap: 10rpx;
}

.tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(212, 137, 14, 0.1);
}

/* ── 加载 / 空状态 ── */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 0.8s ease-in-out infinite alternate;
}

@keyframes pulse {
  from { opacity: 0.3; transform: scale(0.8); }
  to { opacity: 1; transform: scale(1); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-hint);
  margin-top: 24rpx;
  margin-bottom: 32rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 40rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--color-primary);
}

.empty-action:active {
  opacity: 0.75;
}

/* ── 回到顶部 ── */
.back-top {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 80rpx;
  height: 80rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(212, 137, 14, 0.3);
  opacity: 0;
  transform: scale(0.5);
  transition: all var(--duration-normal);
  z-index: 10;
}

.back-top.show {
  opacity: 1;
  transform: scale(1);
}

/* ── 深色模式 ── */
.dark-theme .event-card {
  background: #1E1E2E;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.2);
}

.dark-theme .events-nav,
.dark-theme .filter-tabs {
  background: #1E1E2E;
  border-color: rgba(255, 255, 255, 0.06);
}

.dark-theme .filter-tab {
  background: rgba(255, 255, 255, 0.05);
}

.dark-theme .tag {
  background: rgba(212, 137, 14, 0.15);
}

.dark-theme .card-footer {
  border-color: rgba(255, 255, 255, 0.06);
}

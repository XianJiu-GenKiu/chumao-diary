<view class="page"><view class="collection card" wx:for="{{collections}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCollectionTap"><view class="header"><text class="name">{{item.name}}</text><text class="count">{{item.locationIds.length || 0}} 个地点</text></view><text class="description" wx:if="{{item.description}}">{{item.description}}</text><view class="actions"><text class="share" data-id="{{item._id}}" catchtap="onShareCollection">分享</text><text class="delete" data-id="{{item._id}}" catchtap="deleteCollection">删除</text></view></view><view class="empty" wx:if="{{!loading && !error && collections.length === 0}}"><text>还没有地点合集</text><text>创建一个主题合集，收藏喜欢的地点吧</text></view><view class="state" wx:if="{{loading}}">加载中...</view><view class="state" wx:if="{{error}}"><text>{{error}}</text><text class="retry" bindtap="onRetry">重试</text></view><view class="fab" bindtap="createCollection">新建合集</view></view>

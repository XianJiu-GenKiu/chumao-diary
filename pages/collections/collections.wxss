@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page{min-height:100vh;box-sizing:border-box;padding:24rpx;background:#f7f8fa}.card{background:#fff;border-radius:16rpx;padding:28rpx;margin-bottom:20rpx}.header{display:flex;justify-content:space-between}.name{font-size:32rpx;font-weight:600;color:#222}.count,.description{font-size:26rpx;color:#888}.description{display:block;margin-top:14rpx}.actions{display:flex;justify-content:flex-end;gap:24rpx;margin-top:20rpx}.share{color:#d4890e;font-size:26rpx}.delete{color:#d9534f;font-size:26rpx}.empty,.state{display:flex;flex-direction:column;gap:16rpx;align-items:center;padding:160rpx 24rpx;color:#999}.retry{color:#d4890e}.fab{position:fixed;right:40rpx;bottom:50rpx;background:#d4890e;color:#fff;padding:22rpx 32rpx;border-radius:48rpx;box-shadow:0 8rpx 20rpx #d4890e55}

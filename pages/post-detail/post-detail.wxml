<!-- 页面级样式通过 JSON 配置中的 style: wxss 加载，无需 import -->

<view class="page page-detail {{darkMode ? 'dark-theme' : ''}}">
  <!-- 业务/网络错误态：不能再把错误响应当作帖子渲染成空白详情 -->
  <view class="load-error" wx:if="{{loadError && !isLoading}}">
    <icon name="alert-circle" size="72" color="#D0D0D0" />
    <text class="load-error-title">无法显示这条动态</text>
    <text class="load-error-desc">{{loadError}}</text>
    <view class="load-error-actions">
      <view class="load-error-btn" bindtap="onRetryLoad">重新加载</view>
      <view class="load-error-btn ghost" bindtap="onBackFromError">返回</view>
    </view>
  </view>

  <!-- 加载态（骨架屏）：已有缓存内容时不再遮挡正文 -->
  <view class="loading-state" wx:if="{{isLoading && !post}}">
    <view class="skeleton-card card" style="margin-bottom: 16rpx;">
      <view class="post-author">
        <view class="skeleton-block skeleton-avatar"></view>
        <view class="author-info" style="flex:1; margin-left: 24rpx;">
          <view class="skeleton-block skeleton-text" style="width: 120rpx;"></view>
          <view class="skeleton-block skeleton-text" style="width: 80rpx; height: 10px; margin-top: 8rpx;"></view>
        </view>
      </view>
      <view style="padding: 24rpx;">
        <view class="skeleton-block skeleton-text" style="width: 100%;"></view>
        <view class="skeleton-block skeleton-text" style="width: 90%;"></view>
        <view class="skeleton-block skeleton-text" style="width: 70%;"></view>
      </view>
    </view>
  </view>

  <!-- 内容已就绪但互动状态没从云端补齐时的一行提示，不阻断阅读 -->
  <view class="stale-notice" wx:if="{{staleNotice && !isLoading}}">
    <icon name="alert-circle" size="28" color="#B08A4A" />
    <text class="stale-notice-text">{{staleNotice}}</text>
  </view>

  <block wx:if="{{post}}">
    <!-- 帖子作者信息 -->
    <view class="post-author" bindtap="goToUserHome" data-openid="{{post.creatorOpenId}}">
      <image class="author-avatar" src="{{post.authorAvatar || '/images/tabbar/profile.png'}}" mode="aspectFill" lazy-load />
      <view class="author-info">
        <text class="author-name">{{post.authorName || '匿名用户'}}</text>
        <text class="post-time">{{post.createTimeText || ''}}</text>
      </view>
      <view class="more-btn" bindtap="showActionMenu">
        <text class="more-icon">⋯</text>
      </view>
    </view>

    <!-- 帖子内容 -->
    <view class="post-body">
      <text class="post-content" user-select>{{post.content}}</text>

      <!-- 心情标签 -->
      <view class="post-mood" wx:if="{{post.mood}}">
        <view class="mood-badge">
          <icon wx:if="{{post.moodIcon}}" name="{{post.moodIcon}}" size="44" />
          <text>{{post.moodLabel}}</text>
        </view>
      </view>

      <!-- 地点信息 -->
      <view class="post-location" wx:if="{{post.locationName}}" bindtap="goToLocation">
        <icon name="map-pin" size="24" color="#D4890E" />
        <text class="location-text" style="text-decoration: underline;">{{post.locationName}}</text>
      </view>
    </view>

    <!-- 图片展示 -->
    <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
      <view class="image-count" wx:if="{{post.images.length > 1}}">
        <text>{{post.images.length}}张图片</text>
      </view>
      <view class="image-list image-list-{{post.images.length > 1 ? 'grid' : 'single'}} image-count-{{post.images.length}}">
        <image
          class="post-image"
          wx:for="{{post.images}}"
          wx:key="*this"
          src="{{item}}"
          mode="aspectFill"
          lazy-load
          bindtap="previewImage"
          data-index="{{index}}"
        />
      </view>
    </view>

    <!-- 标签展示 -->
    <view class="post-tags" wx:if="{{post.tags && post.tags.length > 0}}">
      <view class="tag tag-primary" wx:for="{{post.tags}}" wx:key="*this" data-tag="{{item}}" bindtap="onTagTap">
        #{{item}}
      </view>
    </view>

    <!-- 装备清单 -->
    <view class="post-tags" wx:if="{{post.equipTags && post.equipTags.length > 0}}">
      <view class="equip-label"><icon name="clipboard" size="28" color="#D4890E" />装备</view>
      <view class="tag tag-outline" wx:for="{{post.equipTags}}" wx:key="*this">
        {{item}}
      </view>
    </view>

    <!-- 互动栏 -->
    <view class="post-actions">
      <view class="action-item {{reactionUp ? 'action-active' : ''}}" data-type="up" bindtap="toggleReaction">
        <icon name="thumbs-up" size="36" color="{{reactionUp ? '#D4890E' : '#999'}}" fill="{{reactionUp}}" />
        <text class="action-text">{{reactionUpCount}}</text>
      </view>
      <view class="action-item {{reactionDown ? 'action-active' : ''}}" data-type="down" bindtap="toggleReaction">
        <icon name="thumbs-down" size="36" color="{{reactionDown ? '#D4890E' : '#999'}}" fill="{{reactionDown}}" />
        <text class="action-text">{{reactionDownCount}}</text>
      </view>
      <view class="action-item">
        <icon name="message-circle" size="36" color="#999" />
        <text class="action-text">{{commentCount}}</text>
      </view>
      <view class="action-item {{isFavorited ? 'action-active' : ''}}" bindtap="toggleFavorite">
        <icon name="star" size="36" color="{{isFavorited ? '#D4890E' : '#999'}}" fill="{{isFavorited}}" />
        <text class="action-text">收藏</text>
      </view>
      <button class="action-item share-btn" open-type="share">
        <icon name="share" size="36" color="#999" />
        <text class="action-text">分享</text>
      </button>
    </view>

    <!-- 评论列表 -->
    <view class="comment-section">
      <view class="comment-header">
        <text class="comment-title">评论 ({{commentCount}})</text>
      </view>

      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <image class="comment-avatar" src="{{item.authorAvatar || '/images/tabbar/profile.png'}}" mode="aspectFill" lazy-load />
          <view class="comment-body">
            <view class="comment-meta">
              <text class="comment-author">{{item.authorName || '匿名用户'}}</text>
              <text class="comment-time">{{item.createTimeText || ''}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
            <view class="comment-reply" wx:if="{{item.parentId}}">
              <text class="reply-to">回复</text>
            </view>
            <view class="comment-actions-row">
              <view class="comment-like-btn" data-id="{{item._id}}" data-index="{{index}}" bindtap="onCommentLikeTap">
                <icon name="heart" size="24" color="{{item.isLiked ? '#D4890E' : '#ccc'}}" fill="{{item.isLiked}}" />
                <text class="comment-like-num" wx:if="{{item.likeCount > 0}}">{{item.likeCount}}</text>
              </view>
              <view class="comment-reply-btn" data-comment="{{item}}" bindtap="setReplyTo">
                <text>回复</text>
              </view>
            </view>
            <view class="comment-replies" wx:if="{{item.replies && item.replies.length > 0}}">
              <view class="comment-reply-item" wx:for="{{item.replies}}" wx:key="_id">
                <text class="reply-author">{{item.authorName || '匿名用户'}}：</text>
                <text>{{item.content}}</text>
                <text class="comment-time">{{item.createTimeText}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="comment-error" wx:elif="{{commentsError}}">
        <text class="empty-text">{{commentsError}}</text>
        <view class="comment-error-retry" bindtap="onRetryComments">重新加载评论</view>
      </view>

      <view class="comment-empty" wx:else>
        <text class="empty-text">暂无评论，快来抢沙发吧~</text>
      </view>
    </view>
  </block>

  <!-- 底部评论输入栏 -->
  <view class="comment-bar">
    <view class="reply-hint" wx:if="{{replyTo}}" bindtap="clearReplyTo">
      <text>回复 {{replyTo.authorName}} ✕</text>
    </view>
    <view class="comment-input-row">
      <input
        class="comment-input"
        placeholder="{{replyTo ? '回复 ' + replyTo.authorName + '...' : '写评论...'}}"
        value="{{commentText}}"
        bindinput="onCommentInput"
        bindconfirm="submitComment"
        confirm-type="send"
      />
      <view class="comment-send {{commentText && !isSubmittingComment ? 'send-active' : ''}}" bindtap="submitComment">
        <text>{{isSubmittingComment ? '发送中…' : '发送'}}</text>
      </view>
    </view>
  </view>
</view>

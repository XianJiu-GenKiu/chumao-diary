@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page-detail {
  background: var(--color-bg-page);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* ── 加载态 ── */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-gray-200);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
  margin-top: var(--space-3);
}

/* ── 作者信息 ── */
.post-author {
  display: flex;
  align-items: center;
  padding: var(--space-4);
  background: var(--color-bg-white);
}

.author-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-gray-100);
}

.author-info {
  margin-left: var(--space-3);
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: var(--text-md);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.post-time {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.more-btn {
  margin-left: auto;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-gray-100, #F0F0F0);
  flex-shrink: 0;
}
.more-icon {
  font-size: 40rpx;
  color: var(--color-text-secondary, #999);
  line-height: 1;
}

/* ── 帖子内容 ── */
.post-body {
  padding: 0 var(--space-4) var(--space-4);
  background: var(--color-bg-white);
}

.post-content {
  font-size: var(--text-md);
  color: var(--color-text-primary);
  line-height: var(--line-height-relaxed);
  white-space: pre-wrap;
  word-break: break-all;
}

.post-mood {
  margin-top: var(--space-3);
}

.mood-badge {
  display: inline-flex;
  align-items: center;
  /* 改为图标 + 文字后需要更大内边距与间距 */
  gap: 8rpx;
  padding: 8rpx var(--space-3) 8rpx 10rpx;
  background: var(--color-primary-bg);
  border-radius: var(--radius-full);
  font-size: 27rpx;
  color: var(--color-primary);
}

.post-location {
  display: flex;
  align-items: center;
  margin-top: var(--space-2);
}

.location-icon {
  font-size: var(--text-sm);
  margin-right: var(--space-1);
}

.location-text {
  font-size: var(--text-sm);
  color: var(--color-primary);
}

/* ── 图片展示 ── */
.post-images {
  background: var(--color-bg-white);
  padding: 0 var(--space-4) var(--space-4);
}

.image-count {
  margin-bottom: var(--space-2);
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

.image-list {
  display: flex;
  gap: var(--space-2);
}

.image-list-single .post-image {
  width: 100%;
  height: 400rpx;
  border-radius: var(--radius-lg);
}

.image-list-grid {
  flex-wrap: wrap;
}

.image-list-grid .post-image {
  width: calc(33.333% - 8rpx);
  aspect-ratio: 1;
  border-radius: var(--radius-md);
}

.image-list-grid.image-count-2 .post-image,
.image-list-grid.image-count-4 .post-image {
  width: calc(50% - 8rpx);
}

.post-image:active {
  opacity: 0.9;
}

/* ── 标签 ── */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  padding: 0 var(--space-4) var(--space-4);
  background: var(--color-bg-white);
}

/* ── 互动栏 ── */
.post-actions {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--space-3) var(--space-4);
  margin-top: var(--space-2);
  background: var(--color-bg-white);
  border-top: 1rpx solid var(--color-divider);
  border-bottom: 1rpx solid var(--color-divider);
}

.action-item {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-2) var(--space-3);
  border-radius: var(--radius-md);
}

.action-item:active {
  background: var(--color-gray-50);
}

.action-icon {
  font-size: 36rpx;
  line-height: 1;
}

.action-text {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
}

.action-active .action-text {
  color: var(--color-primary);
}

/* ── 分享按钮（button 重置） ── */
.share-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-size: inherit;
  color: inherit;
  text-align: left;
  display: flex;
  align-items: center;
  gap: var(--space-1);
  border-radius: var(--radius-md);
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  background: var(--color-gray-50);
}

/* ── 评论区 ── */
.comment-section {
  margin-top: var(--space-2);
  background: var(--color-bg-white);
}

.comment-header {
  padding: var(--space-4);
  border-bottom: 1rpx solid var(--color-divider);
}

.comment-title {
  font-size: var(--text-md);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.comment-list {
  padding: 0 var(--space-4);
}

.comment-item {
  display: flex;
  padding: var(--space-4) 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: var(--color-gray-100);
}

.comment-body {
  margin-left: var(--space-3);
  flex: 1;
}

.comment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.comment-author {
  font-size: var(--text-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
}

.comment-time {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

.comment-text {
  font-size: var(--text-base);
  color: var(--color-text-primary);
  line-height: var(--line-height-normal);
  margin-top: var(--space-1);
}

.comment-reply {
  margin-top: var(--space-1);
}

.reply-to {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

.comment-actions-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: var(--space-1);
}

.comment-like-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.comment-like-btn:active {
  opacity: 0.6;
}

.comment-like-num {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

.comment-reply-btn {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}
.comment-replies { margin-top: 12rpx; padding: 12rpx; background: #F7F7F7; border-radius: 8rpx; }
.comment-reply-item { margin-top: 8rpx; font-size: 24rpx; color: #555; }
.comment-reply-item:first-child { margin-top: 0; }
.reply-author { color: #D4890E; }

.comment-reply-btn:active {
  color: var(--color-primary);
}

.comment-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

/* ── 加载失败态（业务错误不能被渲染成空白详情） ── */
.load-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 60vh;
  padding: 60rpx 48rpx;
  text-align: center;
}
.load-error-title { font-size: var(--text-lg); font-weight: 600; color: var(--color-text-primary); }
.load-error-desc { font-size: var(--text-base); color: var(--color-text-hint); line-height: 1.6; }
.load-error-actions { display: flex; gap: 24rpx; margin-top: 16rpx; }
.load-error-btn {
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--text-base);
}
.load-error-btn.ghost { background: transparent; color: var(--color-text-secondary); border: 1rpx solid var(--color-border, #E5E5E5); }
.load-error-btn:active { opacity: .85; }

/* ── 评论加载失败态（区别于「暂无评论」） ── */
.comment-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 60rpx 0;
}
.comment-error-retry {
  padding: 12rpx 32rpx;
  border: 1rpx solid var(--color-primary);
  border-radius: 999rpx;
  color: var(--color-primary);
  font-size: var(--text-sm);
}

.empty-text {
  font-size: var(--text-base);
  color: var(--color-text-hint);
}

/* ── 底部评论输入栏 ── */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-white);
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.reply-hint {
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-xs);
  color: var(--color-primary);
  background: var(--color-primary-bg);
}

.comment-input-row {
  display: flex;
  align-items: center;
  padding: var(--space-2) var(--space-4);
  padding-bottom: calc(var(--space-2) + env(safe-area-inset-bottom));
}

.comment-input {
  flex: 1;
  height: 80rpx;
  padding: 0 var(--space-4);
  background: var(--color-gray-100);
  border-radius: var(--radius-round);
  font-size: var(--text-base);
}

.comment-send {
  margin-left: var(--space-2);
  padding: var(--space-2) var(--space-4);
  font-size: var(--text-base);
  color: var(--color-text-disabled);
  font-weight: var(--font-weight-medium);
}

.send-active {
  color: var(--color-primary);
}

.equip-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-right: var(--space-2);
}

.comment-send:active {
  opacity: 0.7;
}

/* 降级提示：正文已渲染、只是互动状态没从云端补齐时的一行说明 */
.stale-notice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md, 12rpx);
  background: var(--color-bg-card, #FBF6EC);
  border: 1rpx solid var(--color-border, #EDE3D2);
}

.stale-notice-text {
  font-size: var(--text-sm, 24rpx);
  color: var(--color-text-hint, #8A7A63);
  line-height: 1.5;
}

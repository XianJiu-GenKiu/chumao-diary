<view class="page"><view class="item" wx:for="{{locations}}" wx:key="_id" data-id="{{item._id}}" bindtap="onLocation"><text class="rank">{{index + 1}}</text><image class="cover" wx:if="{{item.images && item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load /><view class="info"><text class="name">{{item.name}}</text><text class="meta">{{item.category || '地点'}} · 热度 {{item.score}}</text></view></view><view class="state" wx:if="{{loading}}">加载中...</view><view class="state" wx:if="{{!loading && error}}"><text>{{error}}</text><text bindtap="onRetry">重试</text></view><view class="state" wx:if="{{!loading && !error && !locations.length}}">暂无数据</view></view>

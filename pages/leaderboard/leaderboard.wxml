<view class="page"><view class="tabs"><view class="tab {{tab === 'locations' ? 'active' : ''}}" data-tab="locations" bindtap="onTab">热门地点</view><view class="tab {{tab === 'users' ? 'active' : ''}}" data-tab="users" bindtap="onTab">活跃创作者</view></view><view wx:if="{{tab === 'locations'}}"><view class="item" wx:for="{{locations}}" wx:key="_id" data-id="{{item._id}}" bindtap="onLocation"><text class="rank">{{index + 1}}</text><image class="cover" wx:if="{{item.images && item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load /><view class="info"><text class="name">{{item.name}}</text><text class="meta">{{item.category || '地点'}} · 热度 {{item.score}}</text></view></view></view><view wx:if="{{tab === 'users'}}"><view class="item" wx:for="{{users}}" wx:key="openId" data-id="{{item.openId}}" bindtap="onUser"><text class="rank">{{index + 1}}</text><image class="avatar" src="{{item.avatar || '/images/tabbar/profile.png'}}" mode="aspectFill" lazy-load /><view class="info"><text class="name">{{item.nickname}}</text><text class="meta">{{item.postCount}} 条动态 · 热度 {{item.score}}</text></view></view></view><view class="state" wx:if="{{loading}}">加载中...</view><view class="state" wx:if="{{!loading && error}}"><text>{{error}}</text><text bindtap="onRetry">重试</text></view></view>

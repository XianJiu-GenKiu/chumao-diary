@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page{min-height:100vh;background:#f7f8fa;padding:24rpx;box-sizing:border-box}.tabs{display:flex;background:#fff;border-radius:16rpx;margin-bottom:20rpx}.tab{flex:1;text-align:center;padding:24rpx;color:#777}.tab.active{color:#d4890e;font-weight:600;border-bottom:4rpx solid #d4890e}.item{display:flex;align-items:center;gap:18rpx;padding:18rpx;margin-bottom:14rpx;background:#fff;border-radius:16rpx}.rank{width:42rpx;text-align:center;font-size:32rpx;font-weight:700;color:#d4890e}.cover,.avatar{width:64rpx;height:64rpx;border-radius:12rpx;background:#eee}.avatar{border-radius:50%}.info{display:flex;flex:1;flex-direction:column;gap:8rpx}.name{font-size:30rpx;color:#222;font-weight:600}.meta{font-size:24rpx;color:#888}.state{padding:120rpx 24rpx;text-align:center;color:#999}.state text:last-child{display:block;margin-top:16rpx;color:#d4890e}

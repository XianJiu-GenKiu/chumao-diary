@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page-event-create {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 60rpx;
}

/* ── 表单区 ── */
.form-section {
  padding: 24rpx;
}

.form-group {
  margin-bottom: 32rpx;
  background: var(--color-surface);
  border-radius: 16rpx;
  padding: 28rpx 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.required {
  color: #e74c3c;
}

.form-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--color-text);
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: var(--color-text);
  padding: 16rpx 0;
}

.placeholder {
  color: var(--color-text-hint);
  font-size: 28rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text);
}

.form-picker.placeholder {
  color: var(--color-text-hint);
}

/* ── 封面 ── */
.cover-upload {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--color-bg);
}

.cover-preview {
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-hint);
}

/* ── 人数 ── */
.capacity-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
}

.capacity-input {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: center;
  border-bottom: 1rpx solid var(--color-border);
  padding: 8rpx 0;
}

.capacity-unit {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ── 标签 ── */
.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
  min-height: 20rpx;
}

.s-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 12rpx 8rpx 20rpx;
  background: rgba(212, 137, 14, 0.12);
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 24rpx;
}

.s-tag-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.s-tag-close:active {
  background: rgba(0, 0, 0, 0.1);
}

.tag-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-option {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
  background: var(--color-bg);
  border: 1rpx solid var(--color-border);
}

.tag-option.selected {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

/* ── 提交 ── */
.submit-area {
  padding: 40rpx 32rpx;
  text-align: center;
}

.submit-btn {
  width: 100%;
  padding: 28rpx 0;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  border: none;
}

.submit-btn::after { border: none; }

.submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.submit-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-hint);
}

/* ── 深色模式 ── */
.dark-theme .form-group {
  background: #1E1E2E;
}

.dark-theme .form-input,
.dark-theme .form-textarea {
  border-color: rgba(255, 255, 255, 0.08);
}

.dark-theme .cover-upload {
  background: rgba(255, 255, 255, 0.05);
}

.dark-theme .tag-option {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.1);
}

.dark-theme .s-tag-close:active {
  background: rgba(255, 255, 255, 0.1);
}

/* 精选页：运营方策展的地点推荐流（纯展示） */
.page {
  min-height: 100vh;
  padding: var(--space-3) var(--page-padding) calc(var(--tab-bar-height) + var(--space-6));
  background: var(--color-bg-page);
  box-sizing: border-box;
}

/* ── 顶部区 ── */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.hero-text { display: flex; flex-direction: column; }
.hero-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-xxl);
  font-weight: var(--font-weight-bold);
  line-height: var(--line-height-tight);
}
.hero-sub {
  margin-top: var(--space-1);
  color: var(--color-text-hint);
  font-size: var(--font-size-xs);
}
.search-entry {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  height: var(--touch-min);
  padding: 0 var(--space-4);
  border-radius: var(--radius-pill);
  background: var(--color-bg-white);
  box-shadow: var(--shadow-sm);
}
.search-entry:active { transform: scale(0.96); }
.search-entry-text {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

/* ── 分区 ── */
.section { margin-bottom: var(--space-5); }
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-3);
}
.section-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
}
.section-more {
  color: var(--color-primary);
  font-size: var(--font-size-xs);
  min-height: var(--touch-sm);
  line-height: var(--touch-sm);
}

/* ── 横向滚动 ── */
.hscroll { width: 100%; white-space: nowrap; }
.hlist { display: inline-flex; gap: var(--space-3); }
.hcard { width: 320rpx; }

/* ── 网格 ── */
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
}

/* ── 卡片 ── */
.card {
  overflow: hidden;
  border-radius: var(--radius-card);
  background: var(--color-bg-white);
  box-shadow: var(--shadow-card);
}
.card:active { transform: scale(0.98); }
.cover {
  display: block;
  width: 100%;
  height: 220rpx;
}
.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-card-forest);
}
.card-body {
  display: flex;
  flex-direction: column;
  padding: var(--space-2) var(--space-3) var(--space-3);
}
.card-name {
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  line-height: var(--line-height-tight);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.card-meta {
  margin-top: var(--space-1);
  color: var(--color-text-hint);
  font-size: var(--font-size-2xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 状态 ── */
.state {
  padding: var(--space-10) 0;
  color: var(--color-text-hint);
  font-size: var(--font-size-sm);
  text-align: center;
}
.retry {
  display: inline-block;
  margin-left: var(--space-2);
  color: var(--color-primary);
}
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-12) var(--space-6);
}
.empty-title {
  margin-top: var(--space-3);
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
}
.empty-desc {
  margin-top: var(--space-1);
  color: var(--color-text-hint);
  font-size: var(--font-size-xs);
  text-align: center;
}

/* ── 深色模式 ── */
.dark-theme .page { background: var(--color-bg-page); }
.dark-theme .card { background: var(--color-bg-card); }

<!-- 精选：运营方整理的地点推荐流。纯展示，无任何用户生成内容入口。 -->
<view class="page">
  <!-- 顶部搜索入口 + 快捷入口 -->
  <view class="hero">
    <view class="hero-text">
      <text class="hero-title">精选</text>
      <text class="hero-sub">运营方整理的出毛地点推荐</text>
    </view>
    <view class="search-entry" bindtap="onSearchTap">
      <icon name="search" size="28" color="#8A6A3A" />
      <text class="search-entry-text">搜索地点</text>
    </view>
  </view>

  <!-- 本季推荐 -->
  <view class="section" wx:if="{{seasonList.length}}">
    <view class="section-head">
      <text class="section-title">{{season ? season + '推荐' : '本季推荐'}}</text>
      <text class="section-more" bindtap="onSeasonalTap">更多</text>
    </view>
    <scroll-view class="hscroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="hlist">
        <view class="card hcard" wx:for="{{seasonList}}" wx:key="_id" data-id="{{item._id}}" bindtap="onLocationTap">
          <image class="cover" wx:if="{{item.images && item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load />
          <view class="cover cover-fallback" wx:else>
            <icon name="map-pin" size="56" color="rgba(255,255,255,0.5)" />
          </view>
          <view class="card-body">
            <text class="card-name">{{item.name}}</text>
            <text class="card-meta">{{item.category || '地点'}}{{item.city ? ' · ' + item.city : ''}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 人气地点 -->
  <view class="section" wx:if="{{hotList.length}}">
    <view class="section-head">
      <text class="section-title">人气地点</text>
      <text class="section-more" bindtap="onLeaderboardTap">完整榜单</text>
    </view>
    <view class="grid">
      <view class="card gcard" wx:for="{{hotList}}" wx:key="_id" data-id="{{item._id}}" bindtap="onLocationTap">
        <image class="cover" wx:if="{{item.images && item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" lazy-load />
        <view class="cover cover-fallback" wx:else>
          <icon name="map-pin" size="56" color="rgba(255,255,255,0.5)" />
        </view>
        <view class="card-body">
          <text class="card-name">{{item.name}}</text>
          <text class="card-meta">{{item.category || '地点'}}{{item.city ? ' · ' + item.city : ''}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="state" wx:if="{{loading}}">加载中...</view>
  <view class="state" wx:if="{{!loading && error}}">
    <text>{{error}}</text>
    <text class="retry" bindtap="onRetry">重试</text>
  </view>
  <view class="empty" wx:if="{{!loading && !error && !seasonList.length && !hotList.length}}">
    <icon name="compass" size="80" color="#ddd" />
    <text class="empty-title">精选内容准备中</text>
    <text class="empty-desc">运营方正在整理地点推荐，先去地图看看附近吧</text>
  </view>
</view>

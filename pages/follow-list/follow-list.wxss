@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F8FA;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.follow-item {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
}

.follow-item:active {
  opacity: 0.7;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.signature {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.state.empty {
  padding: 140rpx 0 20rpx;
  gap: 20rpx;
}

.empty-title {
  font-size: 28rpx;
  color: #888;
}

.empty-desc {
  font-size: 24rpx;
  color: #aaa;
}

.retry {
  color: #D4890E;
  font-size: 26rpx;
}

.no-more {
  color: #bbb;
  font-size: 24rpx;
}

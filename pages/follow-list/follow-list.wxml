<view class="page page-follow-list">
  <view class="follow-item" wx:for="{{list}}" wx:key="openId" bindtap="onUserTap" data-openid="{{item.openId}}">
    <image class="avatar" src="{{item.avatar || '/images/tabbar/profile.png'}}" mode="aspectFill" lazy-load />
    <view class="info">
      <text class="name">{{item.nickname}}</text>
      <text class="signature" wx:if="{{item.signature}}">{{item.signature}}</text>
    </view>
    <icon name="chevron-right" size="28" color="#bbb" />
  </view>

  <view class="state loading" wx:if="{{loading && list.length === 0}}">加载中...</view>
  <view class="state more" wx:if="{{loading && list.length > 0}}">加载中...</view>

  <view class="state empty" wx:if="{{!loading && !errorMessage && list.length === 0}}">
    <icon name="users" size="72" color="#ccc" />
    <text class="empty-title">暂无{{type === 'followers' ? '粉丝' : '关注'}}</text>
    <text class="empty-desc">{{type === 'followers' ? '多发布内容，让更多人认识你' : '去发现页看看其他出毛伙伴吧'}}</text>
  </view>

  <view class="state empty" wx:if="{{errorMessage && list.length === 0}}">
    <text class="empty-title">{{errorMessage}}</text>
    <text class="retry" bindtap="onRetry">点击重试</text>
  </view>

  <view class="state no-more" wx:if="{{!loading && !hasMore && list.length > 0}}">没有更多了</view>
</view>

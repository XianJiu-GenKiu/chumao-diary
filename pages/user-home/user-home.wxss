@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';
.page-user-home {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: var(--space-6);
}

.skeleton-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.user-header {
  display: flex;
  align-items: center;
  padding: var(--space-5) var(--page-padding);
  background: var(--color-surface);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: var(--space-4);
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.user-name {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.user-fursuit {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.user-bio {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: var(--space-4) var(--page-padding);
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-border);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
}

.stats-label {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.stats-divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-border);
}

.action-row {
  display: flex;
  justify-content: center;
  padding: var(--space-3) var(--page-padding);
  background: var(--color-surface);
}

.follow-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 300rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
}

.follow-btn.following {
  background: var(--color-gray-100);
  color: var(--color-text-hint);
}

.follow-btn:active {
  opacity: 0.85;
}

.more-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: var(--space-3);
  border-radius: 50%;
  background: var(--color-gray-100);
}

.more-btn:active {
  opacity: 0.85;
}

.blocked-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin: 0 var(--page-padding);
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--color-gray-100);
  color: var(--color-text-hint);
  font-size: var(--text-sm);
}

.blocked-undo {
  flex: none;
  color: var(--color-primary);
  font-size: var(--text-sm);
  padding: 16rpx 8rpx;
}

.tab-bar {
  display: flex;
  border-bottom: 1rpx solid var(--color-border);
  background: var(--color-surface);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: var(--space-3) 0;
  font-size: var(--text-base);
  color: var(--color-text-hint);
  position: relative;
}

.tab-item.active {
  color: var(--color-primary);
  font-weight: var(--font-semibold);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--color-primary);
}

.content-list {
  padding: var(--space-3) var(--page-padding);
}

.post-card {
  display: flex;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-3);
}

.post-cover {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.post-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-gray-100);
}

.post-info {
  flex: 1;
  padding: var(--space-3);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.post-text {
  font-size: var(--text-sm);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-2);
}

.post-loc {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--text-xs);
  color: var(--color-primary);
}

.post-time {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

.loc-card {
  display: flex;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: var(--space-3);
}

.loc-cover {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.loc-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-gray-100);
}

.loc-info {
  flex: 1;
  padding: var(--space-3);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.loc-name {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-2);
}

.loc-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loc-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--text-xs);
  color: var(--color-primary);
}

.loc-category {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-text {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
}

.load-more {
  text-align: center;
  padding: var(--space-4);
  color: var(--color-text-hint);
  font-size: var(--text-sm);
}

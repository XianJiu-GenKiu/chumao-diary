@import '../../components/common.wxss';
@import '../../styles/design-tokens.wxss';

/* 个人主页 */
.page-profile {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding-bottom: calc(var(--tab-bar-height) + 32rpx);
}

/* ── 顶部用户信息区 ─────────────────────────── */
.profile-header {
  background: var(--color-bg-white);
  padding: var(--space-6) var(--page-padding) var(--space-4);
  position: relative;
}

.settings-btn {
  position: absolute;
  top: var(--space-4);
  right: var(--page-padding);
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-btn:active {
  opacity: 0.7;
  transform: scale(0.9);
  transition: transform var(--duration-fast) var(--ease-spring), opacity var(--duration-fast) var(--ease-bezier);
}

.message-btn {
  position: absolute;
  top: var(--space-4);
  right: calc(var(--page-padding) + 104rpx);
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.message-btn:active {
  opacity: 0.7;
  transform: scale(0.9);
  transition: transform var(--duration-fast) var(--ease-spring), opacity var(--duration-fast) var(--ease-bezier);
}

.message-icon {
  font-size: 40rpx;
}

.message-badge {
  position: absolute;
  top: 4rpx;
  right: 0;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.settings-icon {
  font-size: 40rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 28rpx;
  position: relative;
  min-height: 468rpx;
  width: 100%;
  box-sizing: border-box;
}

.profile-cover-frame {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  /* 高度跟随 .user-info 的实际内容：昵称/简介再长也只会把封面一起撑高，
     文本面板永远不会伸出背景框之外（旧值固定 448rpx，长简介必然溢出）。 */
  height: 100%;
  transform: none;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #FFF0EC 0%, #EBF3FC 52%, #E8F5E9 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.72), var(--shadow-sm);
  z-index: 0;
  pointer-events: none;
}

.profile-cover-img {
  width: calc(100% + 8rpx);
  height: calc(100% + 8rpx);
  margin: -4rpx;
  display: block;
  filter: blur(2rpx);
}

.profile-cover-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, 0.03) 0%, rgba(0, 0, 0, 0.16) 100%),
    radial-gradient(circle at 50% 44%, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0) 42%);
  z-index: 1;
  pointer-events: none;
}

.user-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  margin-bottom: var(--space-3);
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 2;
}

.profile-text-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(100% - 48rpx);
  max-width: 560rpx;
  box-sizing: border-box;
  padding: 12rpx 28rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.08);
  position: relative;
  z-index: 2;
  pointer-events: auto;
}

.user-nickname {
  font-size: var(--text-2xl);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--space-1);
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.65);
}

.user-signature {
  font-size: var(--text-md);
  color: var(--color-text-secondary);
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.7);
  max-width: 100%;
  text-align: center;
  word-break: break-word;
}

.profile-action-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: var(--space-2);
}

.edit-profile-btn,
.logout-btn {
  padding: 8rpx 24rpx;
  font-size: var(--text-sm);
  border-radius: var(--radius-round);
  background: rgba(255, 255, 255, 0.8);
}

.edit-profile-btn {
  color: var(--color-primary);
  border: 1rpx solid var(--color-primary);
}

.logout-btn {
  color: #E02020;
  border: 1rpx solid rgba(224, 32, 32, 0.55);
}

.edit-profile-btn:active {
  background: var(--color-primary-bg);
}

.logout-btn:active {
  background: rgba(224, 32, 32, 0.08);
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 240rpx;
  height: 88rpx;
  margin: 20rpx 0 0;
  padding: 0 36rpx;
  border: 0;
  border-radius: var(--radius-round);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--text-md);
  font-weight: var(--font-semibold);
  line-height: 88rpx;
  position: relative;
  z-index: 3;
  pointer-events: auto;
  box-sizing: border-box;
}

/* 去掉微信 button 的默认描边，保持和原登录入口一致。 */
.login-btn::after {
  border: 0;
}

.login-btn.disabled {
  opacity: 0.65;
  color: #fff;
  background: var(--color-primary);
}

.login-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* 数据统计 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--space-5);
  padding: var(--space-3) 0;
  background: var(--color-gray-50);
  border-radius: var(--radius-lg);
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: var(--text-xl);
  font-weight: var(--font-bold);
  color: var(--color-text-primary);
}

.stats-label {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
  margin-top: 4rpx;
}

.stats-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--color-divider);
}

/* ── Profile Tabs ───────────────────────────── */
.profile-tabs {
  border-bottom: 1rpx solid var(--color-divider);
}

/* Tab 滑动指示器（当前为 2 个 tab 均分宽度；旧值 33.33% 是三 tab 时代遗留，
   会导致橙色指示条与选中文字错位） */
.profile-tabs .tab-indicator {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 50%;
  height: 6rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.profile-tabs .tab-indicator-bar {
  width: 40rpx;
  height: 100%;
  border-radius: 3rpx;
  background: var(--color-primary, #D4890E);
}

/* 滑动指示器取代静态 ::after 指示线 */
.profile-tabs .tab-item.active::after {
  display: none;
}

/* ── 内容区域 ───────────────────────────────── */
.profile-content {
  padding: var(--space-3) var(--page-padding);
}

.collection-entry { display:flex; align-items:center; gap:12rpx; margin:20rpx 24rpx 0; padding:22rpx 24rpx; border-radius:16rpx; background:#fff; color:#444; font-size:28rpx; transition: transform var(--duration-fast) var(--ease-spring), background-color var(--duration-fast) var(--ease-bezier), box-shadow var(--duration-fast) var(--ease-bezier); }
.collection-entry:active { transform: translateY(2rpx) scale(0.985); box-shadow: var(--shadow-sm); }
.collection-entry text { flex:1; }
.collection-entry .admin-entry-desc { flex: none; margin-left: auto; color: var(--color-text-hint); font-size: 26rpx; white-space: nowrap; line-height: 1.4; }
.collection-entry .collection-entry-desc { flex: none; color: var(--color-text-hint); font-size: 26rpx; white-space: nowrap; }
.admin-entry { border:1rpx solid rgba(212,137,14,.2); }

.content-item {
  margin-bottom: var(--space-3);
}

.favorite-location-card {
  margin-left: -8rpx;
  margin-right: -8rpx;
}

.favorite-location-card .item-header {
  padding: var(--space-4) 40rpx var(--space-2);
}

.favorite-location-card .item-title {
  font-size: var(--font-size-base);
  line-height: 1.35;
}

.favorite-location-card .item-cover {
  height: 280rpx;
}

.favorite-location-card .item-excerpt {
  font-size: var(--font-size-md);
  line-height: 1.55;
  padding: var(--space-2) 40rpx var(--space-4);
}

.content-item:active {
  opacity: 0.95;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-4) var(--space-1);
}

.item-title {
  font-size: var(--text-base);
  font-weight: var(--font-semibold);
  color: var(--color-text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
  flex-shrink: 0;
  margin-left: var(--space-2);
}

.item-cover {
  width: 100%;
  height: 240rpx;
  object-fit: cover;
  display: block;
}

.item-body {
  padding: var(--space-3) var(--space-4);
}

.item-excerpt {
  font-size: var(--text-sm);
  color: var(--color-text-secondary);
  padding: var(--space-1) var(--space-4) var(--space-2);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-stats {
  display: flex;
  gap: var(--space-4);
  padding: 0 var(--space-4) var(--space-3);
}

.item-stats .stat-item {
  font-size: var(--text-xs);
  color: var(--color-text-hint);
}

/* ── 加载 / 空状态 ──────────────────────────── */
.loading-more,
.no-more,
.empty-state {
  display: flex;
  justify-content: center;
  padding: var(--space-6) 0;
}

.profile-skeleton {
  padding: var(--space-3) 0;
}

.skeleton-card {
  margin-bottom: var(--space-3);
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  background: var(--color-bg-card);
}

.skeleton-line {
  background: linear-gradient(90deg, #eef0f3 25%, #f7f8fa 37%, #eef0f3 63%);
  background-size: 400% 100%;
  animation: profile-shimmer 1.4s ease infinite;
  border-radius: 8rpx;
}

.skeleton-title { width: 40%; height: 32rpx; }
.skeleton-cover { width: 100%; height: 220rpx; margin: var(--space-3) 0; }
.skeleton-text { width: 90%; height: 22rpx; margin-top: 14rpx; }
.skeleton-text.short { width: 58%; }

@keyframes profile-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

.loading-text,
.no-more-text {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
}

.empty-state {
  flex-direction: column;
  align-items: center;
  padding: var(--space-10) 0;
  gap: 12rpx;
}

.empty-title {
  font-size: var(--text-lg);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

.empty-desc {
  font-size: var(--text-sm);
  color: var(--color-text-hint);
  text-align: center;
  max-width: 400rpx;
}

.empty-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: var(--space-4);
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--text-base);
  font-weight: var(--font-weight-medium);
}

.empty-action:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.empty-text {
  font-size: var(--text-base);
  color: var(--color-text-hint);
}

.agreement-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.45);
}

.agreement-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 32rpx 28rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #fff;
}

.agreement-dialog-title {
  display: block;
  color: var(--color-text-primary);
  font-size: 32rpx;
  font-weight: var(--font-bold);
  text-align: center;
}

.agreement-dialog-content {
  display: block;
  margin-top: 24rpx;
  color: var(--color-text-secondary);
  font-size: 28rpx;
  line-height: 1.7;
}

.agreement-dialog-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.agreement-read-btn,
.agreement-confirm-btn {
  flex: 1;
  margin: 0;
  border-radius: var(--radius-round);
  font-size: 28rpx;
  line-height: 76rpx;
}

.agreement-read-btn {
  color: var(--color-primary);
  background: var(--color-primary-bg);
}

.agreement-confirm-btn {
  color: #fff;
  background: var(--color-primary);
}

.agreement-read-btn::after,
.agreement-confirm-btn::after {
  border: 0;
}

/* ── 数据栏可点击反馈 ──────────────────────────── */
.stats-item-hover {
  opacity: 0.55;
}

/* ── 列表项删除 / 取消收藏入口 ──────────────────── */
.item-stats {
  justify-content: space-between;
  align-items: center;
}

.item-stats .item-delete {
  margin-left: auto;
  flex-shrink: 0;
  font-size: var(--text-xs);
  color: #E02020;
  line-height: 1;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(224, 32, 32, 0.35);
  border-radius: 999rpx;
}

.item-delete-hover {
  opacity: 0.55;
}

.item-body {
  display: flex;
  align-items: center;
}

.item-body-text {
  flex: 1;
  min-width: 0;
}

.item-body-text .item-excerpt {
  padding: 0;
}

.item-body .item-delete {
  flex-shrink: 0;
  margin-left: var(--space-3);
  font-size: var(--text-xs);
  color: #E02020;
  line-height: 1;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(224, 32, 32, 0.35);
  border-radius: 999rpx;
}

/**
 * 出毛日记 · 品牌字体
 * 字体：站酷快乐体 ZCOOL KuaiLe（SIL Open Font License 1.1）
 * 来源：https://github.com/google/fonts/tree/main/ofl/zcoolkuaile
 *
 * 小程序包体积有限，全量中文标题字体体积过大，
 * 因此这里只对品牌标题实际用到的字形做子集化，并以 base64 内联，
 * 避免依赖远程字体域名（wxss 的 font-face 不接受 http 地址）。
 */
@font-face {
  font-family: 'ChumaoBrand';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('data:font/woff2;base64,') format('woff2'),
       url('data:font/ttf;base64,') format('truetype');
}

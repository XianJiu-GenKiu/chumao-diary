/* components/privacy-popup/privacy-popup.wxss */
.pp-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  background: rgba(0, 0, 0, 0.5);
}

.pp-dialog {
  width: 100%;
  box-sizing: border-box;
  padding: 48rpx 40rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pp-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
}

.pp-content {
  margin-top: 24rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: #555555;
  text-align: left;
}

.pp-actions {
  margin-top: 40rpx;
  width: 100%;
  display: flex;
  gap: 20rpx;
}

.pp-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.pp-btn::after {
  border: none;
}

.pp-btn-plain {
  color: #666666;
  background: #f2f2f2;
}

.pp-btn-primary {
  color: #ffffff;
  background: #d4890e;
}

.pp-reject {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #999999;
  padding: 12rpx 24rpx;
}

@import '../common.wxss';

/* 卡片容器 */
.diary-card {
  background: var(--color-bg-white);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  animation: fadeInUp 0.3s ease-out both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.diary-card:active {
  transform: scale(0.98);
  transition: transform 0.1s;
}

/* 图片区 */
.diary-card-image-wrap {
  width: 100%;
  min-height: 200rpx;
  background: var(--color-gray-100);
  position: relative;
}

.diary-card-image {
  width: 100%;
  display: block;
  opacity: 0;
  transition: opacity 0.3s;
}

.diary-card-image.loaded {
  opacity: 1;
}

.diary-card-image-placeholder {
  width: 100%;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-gray-200);
}

.diary-card-placeholder-icon {
  font-size: 48rpx;
  opacity: 0.5;
}

/* 信息区 */
.diary-card-info {
  padding: var(--space-3);
}

/* 头部：地点名称 + 评分 */
.diary-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
}

.diary-card-location {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.diary-card-location:active {
  color: var(--color-primary);
}

.diary-card-no-location {
  color: var(--color-text-hint);
  font-weight: var(--font-weight-normal);
}

.diary-card-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.diary-card-star {
  font-size: var(--font-size-xs);
  color: var(--color-warning-light);
}

.diary-card-rating-text {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
}

/* 底部：种草数 */
.diary-card-footer {
  display: flex;
  align-items: center;
}

.diary-card-seed {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--font-size-xs);
  color: var(--color-text-hint);
}
